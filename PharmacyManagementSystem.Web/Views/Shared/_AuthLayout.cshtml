@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - PharmaCare
    </title>

    <style>

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }

        body {
            font-family:
                "Segoe UI",
                Arial,
                sans-serif;

            background:
                #f1f5f9;

            color:
                #172554;
        }

        .auth-page {
            min-height: 100vh;

            display: flex;

            align-items: center;

            justify-content: center;

            padding: 30px 15px;
        }

        .auth-container {
            width: 100%;

            max-width: 480px;
        }

        .auth-brand {
            text-align: center;

            margin-bottom: 25px;
        }

        .auth-logo {
            width: 58px;
            height: 58px;

            margin: 0 auto 12px;

            display: flex;

            align-items: center;

            justify-content: center;

            background: #2563eb;

            border-radius: 15px;

            font-size: 28px;

            box-shadow:
                0 8px 20px
                rgba(37, 99, 235, .20);
        }

        .auth-brand h1 {
            margin: 0;

            font-size: 24px;

            color: #172554;
        }

        .auth-brand p {
            margin: 5px 0 0;

            font-size: 12px;

            color: #64748b;
        }

        .auth-card {
            background: white;

            border: 1px solid #e2e8f0;

            border-radius: 16px;

            padding: 30px;

            box-shadow:
                0 10px 30px
                rgba(15, 23, 42, .07);
        }

        .auth-card h2 {
            margin: 0;

            text-align: center;

            font-size: 24px;

            color: #172554;
        }

        .auth-description {
            margin: 8px 0 25px;

            text-align: center;

            color: #64748b;

            font-size: 13px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;

            margin-bottom: 7px;

            color: #334155;

            font-size: 12px;

            font-weight: 700;
        }

        .form-control {
            width: 100%;

            padding: 12px 13px;

            border:
                1px solid #cbd5e1;

            border-radius: 9px;

            background: white;

            color: #172554;

            outline: none;

            font-size: 13px;
        }

        .form-control:focus {
            border-color: #2563eb;

            box-shadow:
                0 0 0 3px
                rgba(37, 99, 235, .10);
        }

        textarea.form-control {
            resize: vertical;
        }

        .field-validation {
            display: block;

            margin-top: 5px;

            color: #dc2626;

            font-size: 11px;
        }

        .validation-summary {
            margin-bottom: 18px;

            padding: 11px 13px;

            background: #fef2f2;

            border:
                1px solid #fecaca;

            border-radius: 9px;

            color: #dc2626;

            font-size: 12px;
        }

        .success-message {
            margin-bottom: 18px;

            padding: 11px 13px;

            background: #f0fdf4;

            border:
                1px solid #bbf7d0;

            border-radius: 9px;

            color: #15803d;

            font-size: 12px;
        }

        .error-message {
            margin-bottom: 18px;

            padding: 11px 13px;

            background: #fef2f2;

            border:
                1px solid #fecaca;

            border-radius: 9px;

            color: #dc2626;

            font-size: 12px;
        }

        .primary-btn {
            width: 100%;

            padding: 12px;

            border: none;

            border-radius: 9px;

            background: #2563eb;

            color: white;

            font-size: 13px;

            font-weight: 700;

            cursor: pointer;
        }

        .primary-btn:hover {
            background: #1d4ed8;
        }

        .secondary-btn {
            display: block;

            width: 100%;

            padding: 12px;

            border:
                1px solid #cbd5e1;

            border-radius: 9px;

            background: white;

            color: #334155;

            text-align: center;

            text-decoration: none;

            font-size: 13px;

            font-weight: 600;
        }

        .secondary-btn:hover {
            background: #f8fafc;
        }

        .auth-footer {
            margin-top: 20px;

            text-align: center;

            font-size: 12px;

            color: #64748b;
        }

        .auth-footer a {
            color: #2563eb;

            font-weight: 700;

            text-decoration: none;
        }

        .auth-footer a:hover {
            text-decoration: underline;
        }

        .section-title {
            margin: 25px 0 15px;

            padding-bottom: 8px;

            border-bottom:
                1px solid #e2e8f0;

            color: #172554;

            font-size: 14px;

            font-weight: 700;
        }

        .password-help {
            display: block;

            margin-top: 5px;

            color: #94a3b8;

            font-size: 10px;
        }

        @@media (max-width: 600px) {

            .auth-page {
                padding: 20px 12px;
            }

            .auth-card {
                padding: 22px;
            }

        }

    </style>

</head>

<body>

    <div class="auth-page">

        <div class="auth-container">

            <div class="auth-brand">

                <div class="auth-logo">
                    💊
                </div>

                <h1>
                    PharmaCare
                </h1>

                <p>
                    Pharmacy Management System
                </p>

            </div>

            @RenderBody()

        </div>

    </div>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>