@model PharmacyManagementSystem.Web.Models.Purchase

@{
    ViewData["Title"] = "Purchase Details";
}

<div class="purchase-page">

    <div class="purchase-header">

        <div>
            <h1>Purchase Details</h1>

            <p>
                View purchase and medicine information
            </p>
        </div>

        <a asp-action="Index"
           class="back-btn">
            ← Back to Purchases
        </a>

    </div>


    <div class="purchase-card">

        <div class="details-header">

            <div>
                <span>Invoice Number</span>

                <strong>
                    @Model.InvoiceNumber
                </strong>
            </div>


            <div>
                <span>Purchase Date</span>

                <strong>
                    @Model.PurchaseDate.ToString(
                        "dd/MM/yyyy hh:mm tt")
                </strong>
            </div>


            <div>
                <span>Supplier</span>

                <strong>
                    @Model.SupplierName
                </strong>
            </div>


            <div>
                <span>Total Amount</span>

                <strong class="total-value">
                    Rs. @Model.TotalAmount.ToString("N2")
                </strong>
            </div>

        </div>

    </div>


    <div class="purchase-card">

        <div class="card-heading">

            <div>
                <h2>Purchased Medicines</h2>

                <p>
                    @Model.Items.Count medicine item(s)
                </p>
            </div>

        </div>


        @if (Model.Items != null &&
             Model.Items.Count > 0)
        {
            <div class="table-wrapper">

                <table>

                    <thead>

                        <tr>
                            <th>Medicine</th>
                            <th>Quantity</th>
                            <th>Cost Price</th>
                            <th>Total</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.Items)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.MedicineName
                                    </strong>

                                    <small>
                                        Medicine ID:
                                        @item.MedicineId
                                    </small>
                                </td>

                                <td>
                                    @item.Quantity
                                </td>

                                <td>
                                    Rs.
                                    @item.CostPrice.ToString("N2")
                                </td>

                                <td>
                                    <strong>
                                        Rs.
                                        @item.TotalPrice.ToString("N2")
                                    </strong>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">
                No purchase items found.
            </div>
        }

    </div>


    <div class="action-card">

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="edit-btn">
            Edit Purchase
        </a>


        <button type="button"
                class="delete-btn"
                onclick="openDeleteModal()">
            Delete Purchase
        </button>

    </div>

</div>


<!-- =============================================================
     DELETE MODAL
============================================================== -->

<div id="deleteModal"
     class="modal-overlay"
     style="display:none;">

    <div class="modal-box">

        <div class="modal-icon">
            ⚠
        </div>

        <h2>
            Delete Purchase?
        </h2>

        <p>
            You are about to delete purchase
            <strong>@Model.InvoiceNumber</strong>.
        </p>

        <p class="modal-warning">
            This will also remove the purchased quantities
            from the current stock. This action cannot be undone.
        </p>

        <div class="modal-actions">

            <button type="button"
                    class="modal-cancel"
                    onclick="closeDeleteModal()">
                Cancel
            </button>

            <form asp-action="Delete"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <button type="submit"
                        class="modal-delete">
                    Yes, Delete
                </button>

            </form>

        </div>

    </div>

</div>


<script>

    function openDeleteModal()
    {
        document.getElementById(
            "deleteModal"
        ).style.display = "flex";
    }


    function closeDeleteModal()
    {
        document.getElementById(
            "deleteModal"
        ).style.display = "none";
    }


    document
        .getElementById("deleteModal")
        .addEventListener(
            "click",
            function(event)
            {
                if (event.target === this)
                {
                    closeDeleteModal();
                }
            }
        );

</script>


<style>

