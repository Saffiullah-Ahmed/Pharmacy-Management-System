@model PharmacyManagementSystem.Web.Models.Purchase

@{
    ViewData["Title"] = "New Purchase";

    var suppliers =
        ViewBag.Suppliers
        as List<PharmacyManagementSystem.Web.Models.Supplier>;
}

<div class="purchase-page">

    <!-- =========================================================
         HEADER
    ========================================================== -->

    <div class="purchase-header">

        <div>
            <h1>New Purchase</h1>

            <p>
                Record medicines received from a supplier
            </p>
        </div>

        <a asp-action="Index"
           class="back-btn">

            ← Back to Purchases

        </a>

    </div>


    <!-- =========================================================
         VALIDATION
    ========================================================== -->

    <div asp-validation-summary="ModelOnly"
         class="validation-summary">
    </div>


    <!-- =========================================================
         FORM
    ========================================================== -->

    <form asp-action="Create"
          method="post"
          id="purchaseForm">

        @Html.AntiForgeryToken()

        <!-- =====================================================
             PURCHASE INFORMATION
        ====================================================== -->

        <div class="purchase-card">

            <h2>Purchase Information</h2>

            <div class="form-grid">

                <!-- INVOICE -->

                <div class="form-group">

                    <label>
                        Invoice Number
                    </label>

                    <div class="invoice-box">

                        @ViewBag.InvoiceNumber

                    </div>

                    <input type="hidden"
                           asp-for="InvoiceNumber"
                           value="@ViewBag.InvoiceNumber" />

                </div>


                <!-- SUPPLIER -->

                <div class="form-group">

                    <label asp-for="SupplierName">
                        Supplier
                    </label>

                    @if (suppliers == null ||
                         suppliers.Count == 0)
                    {
                        <div class="no-supplier">

                            <p>
                                No suppliers found.
                            </p>

                            <a asp-controller="Supplier"
                               asp-action="Create"
                               class="create-supplier-btn">

                                + Create Supplier

                            </a>

                        </div>
                    }
                    else
                    {
                        <select asp-for="SupplierName"
                                class="form-control"
                                required>

                            <option value="">
                                -- Select Supplier --
                            </option>

                            @foreach (var supplier in suppliers)
                            {
                                <option value="@supplier.Name">

                                    @supplier.Name

                                    @if (!string.IsNullOrWhiteSpace(
                                        supplier.Company))
                                    {
                                        <text>
                                            | @supplier.Company
                                        </text>
                                    }

                                </option>
                            }

                        </select>
                    }

                    <span asp-validation-for="SupplierName"
                          class="field-error">
                    </span>

                </div>


                <!-- PURCHASE DATE -->

                <div class="form-group">

                    <label asp-for="PurchaseDate">
                        Purchase Date
                    </label>

                    <input asp-for="PurchaseDate"
                           type="datetime-local"
                           class="form-control"
                           required />

                    <span asp-validation-for="PurchaseDate"
                          class="field-error">
                    </span>

                </div>

            </div>

        </div>


        <!-- =========================================================
             MEDICINES
        ========================================================== -->

        <div class="purchase-card">

            <div class="card-header">

                <div>

                    <h2>Purchase Medicines</h2>

                    <p>
                        Search your pharmacy's medicines and add them to this purchase.
                    </p>

                </div>

            </div>


            <!-- =====================================================
                 SEARCH
            ====================================================== -->

            <div class="medicine-search">

                <label for="medicineSearch">
                    Search Medicine
                </label>

                <input type="text"
                       id="medicineSearch"
                       class="form-control"
                       placeholder="Type medicine name, company, category or medicine ID..."
                       autocomplete="off" />

                <div id="searchResults"
                     class="search-results">
                </div>

            </div>


            <!-- =====================================================
                 ITEMS
            ====================================================== -->

            <div id="purchaseItems">

                @if (Model.Items != null &&
                     Model.Items.Count > 0)
                {
                    for (int i = 0;
                         i < Model.Items.Count;
                         i++)
                    {
                        <div class="medicine-row"
                             data-index="@i">

                            <input type="hidden"
                                   name="Items[@i].MedicineId"
                                   value="@Model.Items[i].MedicineId" />

                            <input type="hidden"
                                   name="Items[@i].MedicineName"
                                   value="@Model.Items[i].MedicineName" />

                            <div class="medicine-name">

                                <strong>
                                    @Model.Items[i].MedicineName
                                </strong>

                                <small>
                                    Medicine ID:
                                    @Model.Items[i].MedicineId
                                </small>

                            </div>


                            <div>

                                <label>
                                    Quantity
                                </label>

                                <input type="number"
                                       name="Items[@i].Quantity"
                                       class="form-control item-quantity"
                                       min="1"
                                       value="@Model.Items[i].Quantity"
                                       required />

                            </div>


                            <div>

                                <label>
                                    Cost Price
                                </label>

                                <input type="number"
                                       name="Items[@i].CostPrice"
                                       class="form-control item-cost"
                                       min="0"
                                       step="0.01"
                                       value="@Model.Items[i].CostPrice"
                                       required />

                            </div>


                            <div>

                                <label>
                                    Total
                                </label>

                                <div class="item-total">

                                    Rs.
                                    <span>0.00</span>

                                </div>

                            </div>


                            <button type="button"
                                    class="remove-btn"
                                    onclick="removeMedicine(this)">

                                Remove

                            </button>

                        </div>
                    }
                }

            </div>


            <!-- EMPTY MESSAGE -->

            <div id="emptyMessage"
                 class="empty-message">

                No medicines added yet.
                Search for a medicine above.

            </div>


            <!-- TOTAL -->

            <div class="purchase-total">

                <span>
                    Total Purchase Amount
                </span>

                <strong id="grandTotal">
                    Rs. 0.00
                </strong>

            </div>

        </div>


        <!-- =========================================================
             ACTIONS
        ========================================================== -->

        <div class="form-actions">

            <a asp-action="Index"
               class="cancel-btn">

                Cancel

            </a>

            <button type="submit"
                    class="save-btn"
                    id="savePurchaseButton">

                Save Purchase

            </button>

        </div>

    </form>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        // =========================================================
        // VARIABLES
        // =========================================================

        let itemIndex =
            document.querySelectorAll(".medicine-row").length;

        const searchInput =
            document.getElementById("medicineSearch");

        const searchResults =
            document.getElementById("searchResults");

        const purchaseItems =
            document.getElementById("purchaseItems");

        let searchTimer = null;


        // =========================================================
        // MEDICINE SEARCH
        // =========================================================

        searchInput.addEventListener(
            "input",
            function ()
            {
                clearTimeout(searchTimer);

                const term =
                    this.value.trim();

                if (!term)
                {
                    searchResults.innerHTML = "";

                    searchResults.style.display =
                        "none";

                    return;
                }

                searchTimer =
                    setTimeout(
                        function ()
                        {
                            searchMedicines(term);
                        },
                        250
                    );
            }
        );


        async function searchMedicines(term)
        {
            try
            {
                const url =
                    '@Url.Action("SearchMedicines", "Purchase")'
                    + '?term='
                    + encodeURIComponent(term);

                const response =
                    await fetch(url);

                if (!response.ok)
                {
                    searchResults.innerHTML =
                        '<div class="no-results">Unable to search medicines.</div>';

                    searchResults.style.display =
                        "block";

                    return;
                }

                const medicines =
                    await response.json();

                searchResults.innerHTML = "";


                if (!medicines ||
                    medicines.length === 0)
                {
                    searchResults.innerHTML =
                        '<div class="no-results">No medicine found.</div>';

                    searchResults.style.display =
                        "block";

                    return;
                }


                medicines.forEach(
                    function (medicine)
                    {
                        const div =
                            document.createElement("div");

                        div.className =
                            "search-result";


                        const company =
                            medicine.company || "";

                        const category =
                            medicine.category || "";

                        const companyMedicineId =
                            medicine.companyMedicineId || "";


                        let information =
                            company;


                        if (category)
                        {
                            information +=
                                " | " + category;
                        }


                        if (companyMedicineId)
                        {
                            information +=
                                " | ID: "
                                + companyMedicineId;
                        }


                        div.innerHTML = `

                            <div>

                                <strong>
                                    ${escapeHtml(medicine.name)}
                                </strong>

                                <small>
                                    ${escapeHtml(information)}
                                </small>

                            </div>

                            <div class="result-price">
                                Rs.
                                ${Number(medicine.price || 0).toFixed(2)}
                            </div>

                        `;


                        div.addEventListener(
                            "click",
                            function ()
                            {
                                addMedicine(medicine);

                                searchInput.value = "";

                                searchResults.innerHTML = "";

                                searchResults.style.display =
                                    "none";
                            }
                        );


                        searchResults.appendChild(div);
                    }
                );


                searchResults.style.display =
                    "block";
            }
            catch (error)
            {
                console.error(
                    "Medicine search error:",
                    error
                );

                searchResults.innerHTML =
                    '<div class="no-results">Unable to search medicines.</div>';

                searchResults.style.display =
                    "block";
            }
        }


        // =========================================================
        // ADD MEDICINE
        // =========================================================

        function addMedicine(medicine)
        {
            const existingRows =
                document.querySelectorAll(
                    ".medicine-row"
                );


            // -----------------------------------------------------
            // PREVENT DUPLICATE MEDICINE
            // -----------------------------------------------------

            for (const row of existingRows)
            {
                const medicineInput =
                    row.querySelector(
                        'input[name$=".MedicineId"]'
                    );

                if (medicineInput &&
                    Number(medicineInput.value) ===
                    Number(medicine.id))
                {
                    alert(
                        "This medicine is already added."
                    );

                    return;
                }
            }


            // -----------------------------------------------------
            // CREATE ROW
            // -----------------------------------------------------

            const row =
                document.createElement("div");

            row.className =
                "medicine-row";

            row.dataset.index =
                itemIndex;


            row.innerHTML = `

                <input type="hidden"
                       name="Items[${itemIndex}].MedicineId"
                       value="${Number(medicine.id)}" />

                <input type="hidden"
                       name="Items[${itemIndex}].MedicineName"
                       value="${escapeAttribute(medicine.name)}" />


                <div class="medicine-name">

                    <strong>
                        ${escapeHtml(medicine.name)}
                    </strong>

                    <small>
                        Medicine ID:
                        ${Number(medicine.id)}
                    </small>

                </div>


                <div>

                    <label>
                        Quantity
                    </label>

                    <input type="number"
                           name="Items[${itemIndex}].Quantity"
                           class="form-control item-quantity"
                           min="1"
                           value="1"
                           required />

                </div>


                <div>

                    <label>
                        Cost Price
                    </label>

                    <input type="number"
                           name="Items[${itemIndex}].CostPrice"
                           class="form-control item-cost"
                           min="0"
                           step="0.01"
                           value="${Number(medicine.price || 0).toFixed(2)}"
                           required />

                </div>


                <div>

                    <label>
                        Total
                    </label>

                    <div class="item-total">

                        Rs.
                        <span>0.00</span>

                    </div>

                </div>


                <button type="button"
                        class="remove-btn"
                        onclick="removeMedicine(this)">

                    Remove

                </button>

            `;


            purchaseItems.appendChild(row);

            itemIndex++;


            attachCalculation(row);

            updateEmptyMessage();

            calculateGrandTotal();
        }


        // =========================================================
        // REMOVE MEDICINE
        // =========================================================

        function removeMedicine(button)
        {
            const row =
                button.closest(".medicine-row");

            if (!row)
            {
                return;
            }


            row.remove();


            updateEmptyMessage();

            calculateGrandTotal();
        }


        // =========================================================
        // CALCULATIONS
        // =========================================================

        function attachCalculation(row)
        {
            const quantity =
                row.querySelector(
                    ".item-quantity"
                );

            const cost =
                row.querySelector(
                    ".item-cost"
                );


            quantity.addEventListener(
                "input",
                function ()
                {
                    calculateRowTotal(row);

                    calculateGrandTotal();
                }
            );


            cost.addEventListener(
                "input",
                function ()
                {
                    calculateRowTotal(row);

                    calculateGrandTotal();
                }
            );


            calculateRowTotal(row);
        }


        function calculateRowTotal(row)
        {
            const quantity =
                Number(
                    row.querySelector(
                        ".item-quantity"
                    ).value
                ) || 0;


            const cost =
                Number(
                    row.querySelector(
                        ".item-cost"
                    ).value
                ) || 0;


            const total =
                quantity * cost;


            row.querySelector(
                ".item-total span"
            ).textContent =
                total.toFixed(2);
        }


        function calculateGrandTotal()
        {
            let total = 0;


            document
                .querySelectorAll(".medicine-row")
                .forEach(
                    function (row)
                    {
                        const quantity =
                            Number(
                                row.querySelector(
                                    ".item-quantity"
                                ).value
                            ) || 0;


                        const cost =
                            Number(
                                row.querySelector(
                                    ".item-cost"
                                ).value
                            ) || 0;


                        total +=
                            quantity * cost;
                    }
                );


            document.getElementById(
                "grandTotal"
            ).textContent =
                "Rs. "
                + total.toFixed(2);
        }


        // =========================================================
        // EMPTY MESSAGE
        // =========================================================

        function updateEmptyMessage()
        {
            const rows =
                document.querySelectorAll(
                    ".medicine-row"
                );


            document.getElementById(
                "emptyMessage"
            ).style.display =
                rows.length === 0
                    ? "block"
                    : "none";
        }


        // =========================================================
        // ESCAPE HTML
        // =========================================================

        function escapeHtml(value)
        {
            return String(value ?? "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }


        function escapeAttribute(value)
        {
            return String(value ?? "")
                .replace(/&/g, "&amp;")
                .replace(/"/g, "&quot;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;");
        }


        // =========================================================
        // CLICK OUTSIDE SEARCH RESULTS
        // =========================================================

        document.addEventListener(
            "click",
            function (event)
            {
                if (!event.target.closest(
                    ".medicine-search"
                ))
                {
                    searchResults.style.display =
                        "none";
                }
            }
        );


        // =========================================================
        // INITIALIZE EXISTING ROWS
        // =========================================================

        document
            .querySelectorAll(".medicine-row")
            .forEach(
                function (row)
                {
                    attachCalculation(row);
                }
            );


        updateEmptyMessage();

        calculateGrandTotal();


        // =========================================================
        // FORM VALIDATION
        // =========================================================

        document
            .getElementById("purchaseForm")
            .addEventListener(
                "submit",
                function (event)
                {
                    const rows =
                        document.querySelectorAll(
                            ".medicine-row"
                        );


                    if (rows.length === 0)
                    {
                        event.preventDefault();

                        alert(
                            "Please add at least one medicine."
                        );

                        return;
                    }


                    // -------------------------------------------------
                    // Validate every row
                    // -------------------------------------------------

                    for (const row of rows)
                    {
                        const medicineId =
                            Number(
                                row.querySelector(
                                    'input[name$=".MedicineId"]'
                                ).value
                            );


                        const quantity =
                            Number(
                                row.querySelector(
                                    ".item-quantity"
                                ).value
                            );


                        const cost =
                            Number(
                                row.querySelector(
                                    ".item-cost"
                                ).value
                            );


                        if (medicineId <= 0)
                        {
                            event.preventDefault();

                            alert(
                                "Please select a valid medicine."
                            );

                            return;
                        }


                        if (quantity <= 0)
                        {
                            event.preventDefault();

                            alert(
                                "Medicine quantity must be greater than zero."
                            );

                            return;
                        }


                        if (cost < 0 ||
                            Number.isNaN(cost))
                        {
                            event.preventDefault();

                            alert(
                                "Cost price cannot be negative."
                            );

                            return;
                        }
                    }
                }
            );

    </script>
}


<style>

    /* =========================================================
       PAGE
    ========================================================== */

    .purchase-page
    {
        max-width: 1100px;
        margin: 0 auto;
    }


    /* =========================================================
       HEADER
    ========================================================== */

    .purchase-header
    {
        display: flex;
        justify-content: space-between;
        align-items: center;

        margin-bottom: 22px;
    }


    .purchase-header h1
    {
        margin: 0;

        color: #172554;

        font-size: 30px;
    }


    .purchase-header p
    {
        margin: 5px 0 0;

        color: #64748b;

        font-size: 14px;
    }


    .back-btn
    {
        padding: 10px 15px;

        background: white;

        color: #475569;

        border: 1px solid #e2e8f0;

        border-radius: 9px;

        text-decoration: none;

        font-size: 13px;

        font-weight: 600;
    }


    .back-btn:hover
    {
        background: #f8fafc;

        color: #172554;
    }


    /* =========================================================
       CARDS
    ========================================================== */

    .purchase-card
    {
        background: white;

        border: 1px solid #e2e8f0;

        border-radius: 15px;

        padding: 25px;

        margin-bottom: 18px;

        box-shadow:
            0 4px 16px
            rgba(15,23,42,.05);
    }


    .purchase-card h2
    {
        margin: 0 0 18px;

        color: #172554;

        font-size: 20px;
    }


    .card-header p
    {
        margin: -10px 0 20px;

        color: #64748b;

        font-size: 13px;
    }


    /* =========================================================
       FORM
    ========================================================== */

    .form-grid
    {
        display: grid;

        grid-template-columns:
            repeat(2, 1fr);

        gap: 18px;
    }


    .form-group
    {
        margin-bottom: 10px;
    }


    .form-group label,
    .medicine-search label,
    .medicine-row label
    {
        display: block;

        margin-bottom: 7px;

        color: #334155;

        font-size: 12px;

        font-weight: 700;
    }


    .form-control
    {
        width: 100%;

        box-sizing: border-box;

        padding: 11px 13px;

        border: 1px solid #cbd5e1;

        border-radius: 9px;

        outline: none;

        background: white;

        color: #172554;

        font-size: 13px;

        transition: .2s;
    }


    .form-control:focus
    {
        border-color: #2563eb;

        box-shadow:
            0 0 0 3px
            rgba(37,99,235,.10);
    }


    /* =========================================================
       INVOICE
    ========================================================== */

    .invoice-box
    {
        padding: 11px 13px;

        background: #eff6ff;

        border: 1px solid #dbeafe;

        border-radius: 9px;

        color: #1d4ed8;

        font-weight: 700;

        font-size: 13px;
    }


    /* =========================================================
       SEARCH
    ========================================================== */

    .medicine-search
    {
        position: relative;

        margin-bottom: 20px;
    }


    .search-results
    {
        display: none;

        position: absolute;

        left: 0;
        right: 0;

        top: 73px;

        z-index: 100;

        background: white;

        border: 1px solid #cbd5e1;

        border-radius: 9px;

        box-shadow:
            0 10px 25px
            rgba(15,23,42,.12);

        max-height: 350px;

        overflow-y: auto;
    }


    .search-result
    {
        display: flex;

        justify-content: space-between;

        align-items: center;

        gap: 15px;

        padding: 12px 14px;

        border-bottom: 1px solid #f1f5f9;

        cursor: pointer;
    }


    .search-result:last-child
    {
        border-bottom: none;
    }


    .search-result:hover
    {
        background: #f8fafc;
    }


    .search-result strong
    {
        display: block;

        color: #172554;

        font-size: 13px;
    }


    .search-result small
    {
        display: block;

        margin-top: 3px;

        color: #64748b;

        font-size: 11px;
    }


    .result-price
    {
        color: #15803d;

        font-size: 12px;

        font-weight: 700;

        white-space: nowrap;
    }


    .no-results
    {
        padding: 14px;

        color: #64748b;

        font-size: 12px;
    }


    /* =========================================================
       MEDICINE ROW
    ========================================================== */

    .medicine-row
    {
        display: grid;

        grid-template-columns:
            minmax(220px, 2fr)
            1fr
            1fr
            1fr
            auto;

        gap: 12px;

        align-items: end;

        padding: 15px;

        margin-bottom: 10px;

        background: #f8fafc;

        border: 1px solid #e2e8f0;

        border-radius: 10px;
    }


    .medicine-name
    {
        padding-bottom: 4px;
    }


    .medicine-name strong
    {
        display: block;

        color: #172554;

        font-size: 13px;
    }


    .medicine-name small
    {
        display: block;

        margin-top: 4px;

        color: #64748b;

        font-size: 10px;
    }


    .item-total
    {
        padding: 11px 10px;

        background: white;

        border: 1px solid #e2e8f0;

        border-radius: 9px;

        color: #172554;

        font-size: 13px;

        font-weight: 700;
    }


    .remove-btn
    {
        padding: 11px 12px;

        background: #fef2f2;

        color: #dc2626;

        border: 1px solid #fecaca;

        border-radius: 9px;

        cursor: pointer;

        font-size: 11px;

        font-weight: 700;
    }


    .remove-btn:hover
    {
        background: #fee2e2;
    }


    /* =========================================================
       EMPTY MESSAGE
    ========================================================== */

    .empty-message
    {
        padding: 20px;

        text-align: center;

        background: #f8fafc;

        border: 1px dashed #cbd5e1;

        border-radius: 10px;

        color: #64748b;

        font-size: 13px;
    }


    /* =========================================================
       TOTAL
    ========================================================== */

    .purchase-total
    {
        display: flex;

        justify-content: space-between;

        align-items: center;

        margin-top: 18px;

        padding-top: 18px;

        border-top: 1px solid #e2e8f0;
    }


    .purchase-total span
    {
        color: #64748b;

        font-size: 13px;

        font-weight: 600;
    }


    .purchase-total strong
    {
        color: #172554;

        font-size: 20px;
    }


    /* =========================================================
       BUTTONS
    ========================================================== */

    .form-actions
    {
        display: flex;

        justify-content: flex-end;

        gap: 10px;

        margin-top: 20px;
    }


    .cancel-btn,
    .save-btn,
    .create-supplier-btn
    {
        padding: 11px 18px;

        border-radius: 9px;

        text-decoration: none;

        font-size: 13px;

        font-weight: 600;

        cursor: pointer;
    }


    .cancel-btn
    {
        background: white;

        color: #475569;

        border: 1px solid #cbd5e1;
    }


    .save-btn
    {
        background: #2563eb;

        color: white;

        border: none;
    }


