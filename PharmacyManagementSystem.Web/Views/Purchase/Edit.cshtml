@model PharmacyManagementSystem.Web.Models.Purchase

@{
    ViewData["Title"] = "Edit Purchase";

    var suppliers =
        ViewBag.Suppliers
        as List<PharmacyManagementSystem.Web.Models.Supplier>;
}

<div class="purchase-page">

    <div class="purchase-header">

        <div>
            <h1>Edit Purchase</h1>

            <p>
                Update purchase information and quantities
            </p>
        </div>

        <a asp-action="Details"
           asp-route-id="@Model.Id"
           class="back-btn">
            ← Back to Purchase
        </a>

    </div>


    <div asp-validation-summary="ModelOnly"
         class="validation-summary">
    </div>


    <div class="warning-box">

        <strong>Stock warning</strong>

        <span>
            Changing purchase quantities will also adjust the current medicine stock.
            A reduction cannot be made if the pharmacy no longer has enough stock to reverse it.
        </span>

    </div>


    <form asp-action="Edit"
          method="post"
          id="purchaseForm">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="Id" />

        <input type="hidden"
               asp-for="InvoiceNumber" />


        <!-- =====================================================
             PURCHASE INFORMATION
        ====================================================== -->

        <div class="purchase-card">

            <h2>Purchase Information</h2>

            <div class="form-grid">

                <div class="form-group">

                    <label>Invoice Number</label>

                    <div class="invoice-box">
                        @Model.InvoiceNumber
                    </div>

                </div>


                <div class="form-group">

                    <label asp-for="SupplierName">
                        Supplier
                    </label>

                    <select asp-for="SupplierName"
                            class="form-control"
                            required>

                        <option value="">
                            -- Select Supplier --
                        </option>

                        @if (suppliers != null)
                        {
                            foreach (var supplier in suppliers)
                            {
                                <option value="@supplier.Name">
                                    @supplier.Name
                                    @if (!string.IsNullOrWhiteSpace(
                                        supplier.Company))
                                    {
                                        <text>
                                            | @supplier.Company
                                        </text>
                                    }
                                </option>
                            }
                        }

                    </select>

                    <span asp-validation-for="SupplierName"
                          class="field-error">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="PurchaseDate">
                        Purchase Date
                    </label>

                    <input asp-for="PurchaseDate"
                           type="datetime-local"
                           class="form-control"
                           required />

                    <span asp-validation-for="PurchaseDate"
                          class="field-error">
                    </span>

                </div>

            </div>

        </div>


        <!-- =====================================================
             MEDICINES
        ====================================================== -->

        <div class="purchase-card">

            <div class="card-header">

                <div>
                    <h2>Purchase Medicines</h2>

                    <p>
                        Search for medicines to add or modify this purchase.
                    </p>
                </div>

            </div>


            <div class="medicine-search">

                <label>
                    Search Medicine
                </label>

                <input type="text"
                       id="medicineSearch"
                       class="form-control"
                       placeholder="Type medicine name, company, category or medicine ID..."
                       autocomplete="off" />

                <div id="searchResults"
                     class="search-results">
                </div>

            </div>


            <div id="purchaseItems">

                @if (Model.Items != null)
                {
                    for (int i = 0;
                         i < Model.Items.Count;
                         i++)
                    {
                        <div class="medicine-row"
                             data-index="@i">

                            <input type="hidden"
                                   name="Items[@i].MedicineId"
                                   value="@Model.Items[i].MedicineId" />

                            <input type="hidden"
                                   name="Items[@i].MedicineName"
                                   value="@Model.Items[i].MedicineName" />

                            <div class="medicine-name">

                                <strong>
                                    @Model.Items[i].MedicineName
                                </strong>

                                <small>
                                    Medicine ID:
                                    @Model.Items[i].MedicineId
                                </small>

                            </div>


                            <div>

                                <label>Quantity</label>

                                <input type="number"
                                       name="Items[@i].Quantity"
                                       class="form-control item-quantity"
                                       min="1"
                                       value="@Model.Items[i].Quantity"
                                       required />

                            </div>


                            <div>

                                <label>Cost Price</label>

                                <input type="number"
                                       name="Items[@i].CostPrice"
                                       class="form-control item-cost"
                                       min="0"
                                       step="0.01"
                                       value="@Model.Items[i].CostPrice"
                                       required />

                            </div>


                            <div>

                                <label>Total</label>

                                <div class="item-total">
                                    Rs.
                                    <span>0.00</span>
                                </div>

                            </div>


                            <button type="button"
                                    class="remove-btn"
                                    onclick="removeMedicine(this)">
                                Remove
                            </button>

                        </div>
                    }
                }

            </div>


            <div id="emptyMessage"
                 class="empty-message">

                No medicines added.

            </div>


            <div class="purchase-total">

                <span>
                    Total Purchase Amount
                </span>

                <strong id="grandTotal">
                    Rs. 0.00
                </strong>

            </div>

        </div>


        <div class="form-actions">

            <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="cancel-btn">
                Cancel
            </a>

            <button type="submit"
                    class="save-btn">
                Update Purchase
            </button>

        </div>

    </form>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        let itemIndex =
            document.querySelectorAll(
                ".medicine-row"
            ).length;


        const searchInput =
            document.getElementById(
                "medicineSearch"
            );

        const searchResults =
            document.getElementById(
                "searchResults"
            );


        let searchTimer = null;


        // =========================================================
        // SEARCH
        // =========================================================

        searchInput.addEventListener(
            "input",
            function()
            {
                clearTimeout(searchTimer);

                const term =
                    this.value.trim();

                if (!term)
                {
                    searchResults.innerHTML = "";
                    searchResults.style.display =
                        "none";

                    return;
                }

                searchTimer =
                    setTimeout(
                        () => searchMedicines(term),
                        250
                    );
            }
        );


        async function searchMedicines(term)
        {
            try
            {
                const response =
                    await fetch(
                        '@Url.Action("SearchMedicines", "Purchase")'
                        + '?term='
                        + encodeURIComponent(term)
                    );

                if (!response.ok)
                {
                    searchResults.style.display =
                        "none";

                    return;
                }

                const medicines =
                    await response.json();

                searchResults.innerHTML = "";

                if (!medicines.length)
                {
                    searchResults.innerHTML =
                        '<div class="no-results">No medicine found.</div>';

                    searchResults.style.display =
                        "block";

                    return;
                }

                medicines.forEach(
                    medicine =>
                    {
                        const div =
                            document.createElement(
                                "div"
                            );

                        div.className =
                            "search-result";

                        div.innerHTML = `
                            <div>
                                <strong>${escapeHtml(medicine.name)}</strong>

                                <small>
                                    ${escapeHtml(medicine.company || "")}
                                    ${medicine.companyMedicineId
                                        ? " | ID: " + escapeHtml(medicine.companyMedicineId)
                                        : ""}
                                </small>
                            </div>

                            <div class="result-price">
                                Rs. ${Number(medicine.price).toFixed(2)}
                            </div>
                        `;

                        div.addEventListener(
                            "click",
                            function()
                            {
                                addMedicine(medicine);

                                searchInput.value = "";

                                searchResults.innerHTML = "";

                                searchResults.style.display =
                                    "none";
                            }
                        );

                        searchResults.appendChild(div);
                    }
                );

                searchResults.style.display =
                    "block";
            }
            catch
            {
                searchResults.style.display =
                    "none";
            }
        }


        // =========================================================
        // ADD MEDICINE
        // =========================================================

        function addMedicine(medicine)
        {
            const rows =
                document.querySelectorAll(
                    ".medicine-row"
                );

            for (const row of rows)
            {
                const medicineInput =
                    row.querySelector(
                        'input[name$=".MedicineId"]'
                    );

                if (medicineInput &&
                    Number(medicineInput.value) ===
                    Number(medicine.id))
                {
                    alert(
                        "This medicine is already in the purchase."
                    );

                    return;
                }
            }

            const row =
                document.createElement(
                    "div"
                );

            row.className =
                "medicine-row";

            row.innerHTML = `
                <input type="hidden"
                       name="Items[${itemIndex}].MedicineId"
                       value="${medicine.id}" />

                <input type="hidden"
                       name="Items[${itemIndex}].MedicineName"
                       value="${escapeAttribute(medicine.name)}" />

                <div class="medicine-name">

                    <strong>
                        ${escapeHtml(medicine.name)}
                    </strong>

                    <small>
                        Medicine ID: ${medicine.id}
                    </small>

                </div>

                <div>

                    <label>Quantity</label>

                    <input type="number"
                           name="Items[${itemIndex}].Quantity"
                           class="form-control item-quantity"
                           min="1"
                           value="1"
                           required />

                </div>

                <div>

                    <label>Cost Price</label>

                    <input type="number"
                           name="Items[${itemIndex}].CostPrice"
                           class="form-control item-cost"
                           min="0"
                           step="0.01"
                           value="${Number(medicine.price).toFixed(2)}"
                           required />

                </div>

                <div>

                    <label>Total</label>

                    <div class="item-total">
                        Rs.
                        <span>0.00</span>
                    </div>

                </div>

                <button type="button"
                        class="remove-btn"
                        onclick="removeMedicine(this)">
                    Remove
                </button>
            `;

            document
                .getElementById(
                    "purchaseItems"
                )
                .appendChild(row);

            itemIndex++;

            attachCalculation(row);

            updateEmptyMessage();

            calculateGrandTotal();
        }


        // =========================================================
        // REMOVE
        // =========================================================

        function removeMedicine(button)
        {
            const row =
                button.closest(
                    ".medicine-row"
                );

            if (!row)
                return;

            row.remove();

            updateEmptyMessage();

            calculateGrandTotal();
        }


        // =========================================================
        // CALCULATION
        // =========================================================

        function attachCalculation(row)
        {
            const quantity =
                row.querySelector(
                    ".item-quantity"
                );

            const cost =
                row.querySelector(
                    ".item-cost"
                );

            quantity.addEventListener(
                "input",
                function()
                {
                    calculateRowTotal(row);
                    calculateGrandTotal();
                }
            );

            cost.addEventListener(
                "input",
                function()
                {
                    calculateRowTotal(row);
                    calculateGrandTotal();
                }
            );

            calculateRowTotal(row);
        }


        function calculateRowTotal(row)
        {
            const quantity =
                Number(
                    row.querySelector(
                        ".item-quantity"
                    ).value
                ) || 0;

            const cost =
                Number(
                    row.querySelector(
                        ".item-cost"
                    ).value
                ) || 0;

            row.querySelector(
                ".item-total span"
            ).textContent =
                (quantity * cost).toFixed(2);
        }


        function calculateGrandTotal()
        {
            let total = 0;

            document
                .querySelectorAll(
                    ".medicine-row"
                )
                .forEach(
                    row =>
                    {
                        const quantity =
                            Number(
                                row.querySelector(
                                    ".item-quantity"
                                ).value
                            ) || 0;

                        const cost =
                            Number(
                                row.querySelector(
                                    ".item-cost"
                                ).value
                            ) || 0;

                        total +=
                            quantity * cost;
                    }
                );

            document.getElementById(
                "grandTotal"
            ).textContent =
                "Rs. " + total.toFixed(2);
        }


        function updateEmptyMessage()
        {
            const count =
                document.querySelectorAll(
                    ".medicine-row"
                ).length;

            document.getElementById(
                "emptyMessage"
            ).style.display =
                count === 0
                    ? "block"
                    : "none";
        }


        // =========================================================
        // ESCAPING
        // =========================================================

        function escapeHtml(value)
        {
            return String(value ?? "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }


        function escapeAttribute(value)
        {
            return String(value ?? "")
                .replace(/&/g, "&amp;")
                .replace(/"/g, "&quot;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;");
        }


        // =========================================================
        // INITIALIZE
        // =========================================================

        document
            .querySelectorAll(
                ".medicine-row"
            )
            .forEach(
                row =>
                {
                    attachCalculation(row);
                }
            );

        updateEmptyMessage();

        calculateGrandTotal();


        // =========================================================
        // FORM VALIDATION
        // =========================================================

        document
            .getElementById(
                "purchaseForm"
            )
            .addEventListener(
                "submit",
                function(event)
                {
                    const rows =
                        document.querySelectorAll(
                            ".medicine-row"
                        );

                    if (rows.length === 0)
                    {
                        event.preventDefault();

                        alert(
                            "Please add at least one medicine."
                        );
                    }
                }
            );

    </script>
}


<style>

    .purchase-page
    {
        max-width: 1100px;
        margin: 0 auto;
    }

    .purchase-header
    {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
    }

