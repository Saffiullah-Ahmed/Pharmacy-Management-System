        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 13px 15px;
        margin-bottom: 18px;
        background: #fff7ed;
        border: 1px solid #fed7aa;
        border-radius: 10px;
        color: #9a3412;
        font-size: 12px;
    }

    .purchase-card
    {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 18px;
        box-shadow:
