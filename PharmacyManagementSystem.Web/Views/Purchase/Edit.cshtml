        margin: 5px 0 0;
        color: #64748b;
        font-size: 14px;
    }

    .back-btn
    {
        padding: 10px 15px;
        background: white;
        color: #475569;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
    }

    .warning-box
