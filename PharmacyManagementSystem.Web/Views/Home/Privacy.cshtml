@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="privacy-page">

    <!-- =========================================================
         HEADER
    ========================================================== -->

    <div class="privacy-header">

        <div>

            <span class="privacy-eyebrow">
                PHARMACARE
            </span>

            <h1>
                Privacy Policy
            </h1>

            <p>
                How PharmaCare handles and protects pharmacy information.
            </p>

        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="back-button">

            ← Back to Dashboard

        </a>

    </div>


    <!-- =========================================================
         INTRODUCTION
    ========================================================== -->

    <div class="privacy-card intro-card">

        <div class="privacy-icon">
            🔒
        </div>

        <div>

            <h2>
                Your Data Matters
            </h2>

            <p>
                PharmaCare is designed to help pharmacies manage medicines,
                inventory, sales, purchases, returns, users, and reports
                while keeping pharmacy information separated and protected.
            </p>

        </div>

    </div>


    <!-- =========================================================
         POLICY GRID
    ========================================================== -->

    <div class="privacy-grid">


        <!-- DATA COLLECTION -->

        <div class="privacy-card">

            <div class="section-icon">
                📋
            </div>

            <h2>
                Information We Store
            </h2>

            <p>
                The system may store information required to operate the
                pharmacy management system, including:
            </p>

            <ul>

                <li>
                    Pharmacy information
                </li>

                <li>
                    Medicine and inventory records
                </li>

                <li>
                    Sales and purchase records
                </li>

                <li>
                    Return transactions
                </li>

                <li>
                    User account information
                </li>

                <li>
                    Pharmacy configuration settings
                </li>

            </ul>

        </div>


        <!-- DATA ISOLATION -->

        <div class="privacy-card">

            <div class="section-icon">
                🏪
            </div>

            <h2>
                Pharmacy Data Isolation
            </h2>

            <p>
                Each pharmacy operates within its own pharmacy scope.
                Records belonging to one pharmacy should not be displayed
                or modified through another pharmacy's account.
            </p>

            <div class="privacy-note">

                <strong>
                    Important
                </strong>

                <span>
                    Pharmacy-specific operations are associated with the
                    authenticated pharmacy account.
                </span>

            </div>

        </div>


        <!-- ACCOUNT SECURITY -->

        <div class="privacy-card">

            <div class="section-icon">
                🛡️
            </div>

            <h2>
                Account Security
            </h2>

            <p>
                User accounts are protected through authentication and
                password-based access. Users should keep their passwords
                private and avoid sharing account credentials.
            </p>

            <ul>

                <li>
                    Use a strong password
                </li>

                <li>
                    Do not share your password
                </li>

                <li>
                    Change your password if you suspect it has been exposed
                </li>

                <li>
                    Log out when using a shared computer
                </li>

            </ul>

        </div>


        <!-- SYSTEM USE -->

        <div class="privacy-card">

            <div class="section-icon">
                ⚙️
            </div>

            <h2>
                Use of Information
            </h2>

            <p>
                Information stored in PharmaCare is used to provide the
                pharmacy management features available within the system.
            </p>

            <p>
                This includes inventory management, sales processing,
                purchases, returns, reports, account management, and
                pharmacy settings.
            </p>

        </div>

    </div>


    <!-- =========================================================
         RESPONSIBILITY
    ========================================================== -->

    <div class="privacy-card responsibility-card">

        <div class="responsibility-icon">
            ℹ
        </div>

        <div>

            <h2>
                Pharmacy Administrator Responsibility
            </h2>

            <p>
                Pharmacy administrators are responsible for managing their
                pharmacy's users, protecting account credentials, and
                ensuring that authorized staff members have appropriate
                access to the system.
            </p>

        </div>

    </div>


    <!-- =========================================================
         FOOTER
    ========================================================== -->

    <div class="privacy-footer">

        <span>
            PharmaCare Pharmacy Management System
        </span>

        <span>
            Privacy Policy
        </span>

    </div>

</div>


<style>

    /* =========================================================
       PAGE
    ========================================================== */

    .privacy-page
    {
        width: 100%;

        max-width: none;

        margin: 0;

        padding: 0 0 35px;

        box-sizing: border-box;
    }


    /* =========================================================
       HEADER
    ========================================================== */

    .privacy-header
    {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 20px;

        margin-bottom: 22px;
    }


    .privacy-eyebrow
    {
        display: block;

        margin-bottom: 5px;

        color: #2563eb;

        font-size: 10px;

        font-weight: 800;

        letter-spacing: 1px;
    }


    .privacy-header h1
    {
        margin: 0;

        color: #172554;

        font-size: 30px;

        font-weight: 750;
    }


    .privacy-header p
    {
        margin: 6px 0 0;

        color: #64748b;

        font-size: 13px;
    }


    .back-button
    {
        padding: 10px 14px;

        background: white;

        border: 1px solid #e2e8f0;

        border-radius: 9px;

        color: #475569;

        text-decoration: none;

        font-size: 11px;

        font-weight: 600;

        white-space: nowrap;
    }


    .back-button:hover
    {
        background: #f8fafc;

        color: #172554;

        text-decoration: none;
    }


    /* =========================================================
       CARD
    ========================================================== */

    .privacy-card
    {
        background: white;

        border: 1px solid #e2e8f0;

        border-radius: 14px;

        padding: 22px;

        box-sizing: border-box;
    }


    /* =========================================================
       INTRO
    ========================================================== */

    .intro-card
    {
        display: flex;

        align-items: flex-start;

        gap: 16px;

        margin-bottom: 18px;

        background:
            linear-gradient(
                135deg,
                #eff6ff,
                #ffffff
            );

        border-color: #dbeafe;
    }


    .privacy-icon
    {
        display: flex;

        align-items: center;

        justify-content: center;

        width: 48px;
        height: 48px;

        flex-shrink: 0;

        background: white;

        border: 1px solid #dbeafe;

        border-radius: 11px;

        font-size: 21px;
    }


    .intro-card h2
    {
        margin: 0;

        color: #172554;

        font-size: 17px;
    }


    .intro-card p
    {
        margin: 6px 0 0;

        color: #64748b;

        font-size: 11px;

        line-height: 1.7;
    }


    /* =========================================================
       GRID
    ========================================================== */

    .privacy-grid
    {
        display: grid;

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 18px;

        margin-bottom: 18px;
    }


    .section-icon
    {
        display: flex;

        align-items: center;

        justify-content: center;

        width: 38px;
        height: 38px;

        margin-bottom: 14px;

        background: #f8fafc;

        border: 1px solid #e2e8f0;

        border-radius: 9px;

        font-size: 17px;
    }


    .privacy-card h2
    {
        margin: 0;

        color: #172554;

        font-size: 16px;

        font-weight: 700;
    }


    .privacy-card p
    {
        margin: 8px 0 0;

        color: #64748b;

        font-size: 11px;

        line-height: 1.7;
    }


    .privacy-card ul
    {
        margin: 12px 0 0;

        padding-left: 18px;

        color: #64748b;

        font-size: 10px;

        line-height: 1.9;
    }


    .privacy-card li
    {
        padding-left: 2px;
    }


    /* =========================================================
       NOTE
    ========================================================== */

    .privacy-note
    {
        display: flex;

        flex-direction: column;

        gap: 4px;

        margin-top: 14px;

        padding: 11px 12px;

        background: #eff6ff;

        border: 1px solid #dbeafe;

        border-radius: 8px;
    }


    .privacy-note strong
    {
        color: #1d4ed8;

        font-size: 10px;
    }


    .privacy-note span
    {
        color: #64748b;

        font-size: 9px;

        line-height: 1.5;
    }


    /* =========================================================
       RESPONSIBILITY
    ========================================================== */

    .responsibility-card
    {
        display: flex;

        align-items: flex-start;

        gap: 13px;

        margin-bottom: 20px;

        background: #f8fafc;
    }


    .responsibility-icon
    {
        display: flex;

        align-items: center;

        justify-content: center;

        width: 32px;
        height: 32px;

        flex-shrink: 0;

        background: #e0f2fe;

        color: #0369a1;

        border-radius: 50%;

        font-size: 13px;

        font-weight: 800;
    }


    .responsibility-card h2
    {
        font-size: 13px;
    }


    .responsibility-card p
    {
        margin-top: 5px;

        font-size: 10px;
    }


    /* =========================================================
       FOOTER
    ========================================================== */

    .privacy-footer
    {
        display: flex;

        align-items: center;

        justify-content: space-between;

        padding: 14px 3px 0;

        border-top: 1px solid #e2e8f0;

        color: #94a3b8;

        font-size: 9px;
    }


    /* =========================================================
       RESPONSIVE
    ========================================================== */

    @@media (max-width: 800px)
    {
        .privacy-header
        {
            align-items: flex-start;

            flex-direction: column;
        }

        .privacy-grid
        {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 500px)
    {
        .intro-card,
        .responsibility-card
        {
            flex-direction: column;
        }

        .privacy-footer
        {
            align-items: flex-start;

            flex-direction: column;

            gap: 5px;
        }
    }

</style>