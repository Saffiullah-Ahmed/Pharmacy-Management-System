@model PharmacyManagementSystem.Web.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
}


<div class="delete-page">

    <!-- ==========================================
         HEADER
    ========================================== -->

    <div class="delete-header">

        <div>

            <h1>
                Delete Customer
            </h1>

            <p>
                Remove this customer from your pharmacy records
            </p>

        </div>


        <a asp-controller="Customer"
           asp-action="Index"
           class="back-btn">

            ← Back to Customers

        </a>

    </div>


    <!-- ==========================================
         DELETE CARD
    ========================================== -->

    <div class="delete-card">


        <!-- TITLE -->

        <div class="delete-card-header">

            <div class="delete-icon">
                🗑️
            </div>

            <div>

                <h2>
                    Confirm Deletion
                </h2>

                <p>
                    Please review the customer before deleting.
                </p>

            </div>

        </div>


        <!-- DIVIDER -->

        <div class="divider"></div>


        <!-- WARNING -->

        <div class="warning-box">

            <strong>
                ⚠️ Are you sure you want to delete this customer?
            </strong>

            <p>
                This action will permanently remove the customer
                from the database.
            </p>

        </div>


        <!-- CUSTOMER INFORMATION -->

        <div class="customer-information">


            <!-- CUSTOMER NAME -->

            <div class="information-item">

                <span>
                    Customer Name
                </span>

                <strong>
                    @Model.Name
                </strong>

            </div>


            <!-- CUSTOMER ID -->

            <div class="information-item">

                <span>
                    Customer ID
                </span>

                <strong>
                    #@Model.Id
                </strong>

            </div>


            <!-- PHONE -->

            <div class="information-item">

                <span>
                    Phone
                </span>

                <strong>
                    @Model.Phone
                </strong>

            </div>


            <!-- CNIC -->

            <div class="information-item">

                <span>
                    CNIC
                </span>

                <strong>

                    @(string.IsNullOrWhiteSpace(Model.CNIC)
                        ? "Not provided"
                        : Model.CNIC)

                </strong>

            </div>


            <!-- ADDRESS -->

            <div class="information-item full-width">

                <span>
                    Address
                </span>

                <strong>

                    @(string.IsNullOrWhiteSpace(Model.Address)
                        ? "Not provided"
                        : Model.Address)

                </strong>

            </div>


            <!-- CREATED -->

            <div class="information-item">

                <span>
                    Created
                </span>

                <strong>
                    @Model.CreatedAt.ToString("dd MMM yyyy")
                </strong>

            </div>

        </div>


        <!-- DIVIDER -->

        <div class="divider"></div>


        <!-- ACTIONS -->

        <div class="delete-actions">

            <a asp-controller="Customer"
               asp-action="Index"
               class="cancel-btn">

                Cancel

            </a>


            <form asp-controller="Customer"
                  asp-action="DeleteConfirmed"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <button type="submit"
                        class="delete-confirm-btn">

                    🗑️ Delete Customer

                </button>

            </form>

        </div>

    </div>

</div>


<style>

    /* ==========================================
       PAGE
    ========================================== */

    .delete-page
    {
        max-width: 900px;
        margin: 0 auto;
        padding-bottom: 40px;
    }


    /* ==========================================
       HEADER
    ========================================== */

    .delete-header
    {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }


    .delete-header h1
    {
        margin: 0;
        color: #172554;
        font-size: 30px;
        font-weight: 700;
    }


    .delete-header p
    {
        margin: 5px 0 0;
        color: #64748b;
        font-size: 14px;
    }


    /* ==========================================
       BACK BUTTON
    ========================================== */

    .back-btn
    {
        padding: 10px 15px;
        background: white;
        color: #475569;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
    }


    .back-btn:hover
    {
        background: #f8fafc;
        color: #172554;
    }


    /* ==========================================
       DELETE CARD
    ========================================== */

    .delete-card
    {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 15px;
        padding: 28px;
        box-shadow: 0 4px 16px rgba(15,23,42,.05);
    }


    /* ==========================================
       CARD HEADER
    ========================================== */

    .delete-card-header
    {
        display: flex;
        align-items: center;
        gap: 15px;
    }


    .delete-icon
    {
        width: 46px;
        height: 46px;

        display: flex;
        align-items: center;
        justify-content: center;

        background: #fef2f2;

        border-radius: 12px;

        font-size: 22px;
    }


    .delete-card-header h2
    {
        margin: 0;
        color: #172554;
        font-size: 20px;
    }


    .delete-card-header p
    {
        margin: 4px 0 0;
        color: #94a3b8;
        font-size: 12px;
    }


    /* ==========================================
       DIVIDER
    ========================================== */

    .divider
    {
        height: 1px;
        background: #e2e8f0;
        margin: 22px 0;
    }


    /* ==========================================
       WARNING
    ========================================== */

    .warning-box
    {
        padding: 18px;

        background: #fff7ed;

        border: 1px solid #fed7aa;

        border-radius: 10px;

        margin-bottom: 22px;
    }


    .warning-box strong
    {
        display: block;

        color: #c2410c;

        font-size: 14px;

        margin-bottom: 6px;
    }


    .warning-box p
    {
        margin: 0;

        color: #9a3412;

        font-size: 12px;
    }


    /* ==========================================
       CUSTOMER INFORMATION
    ========================================== */

    .customer-information
    {
        display: grid;

        grid-template-columns: 1fr 1fr;

        gap: 18px 30px;

        padding: 20px;

        background: #f8fafc;

        border: 1px solid #e2e8f0;

        border-radius: 10px;
    }


    .information-item span
    {
        display: block;

        color: #64748b;

        font-size: 10px;

        margin-bottom: 5px;
    }


    .information-item strong
    {
        display: block;

        color: #172554;

        font-size: 14px;
    }


    .full-width
    {
        grid-column: 1 / -1;
    }


    /* ==========================================
       ACTIONS
    ========================================== */

    .delete-actions
    {
        display: flex;

        justify-content: flex-end;

        align-items: center;

        gap: 10px;
    }


    .delete-actions form
    {
        margin: 0;
    }


    .cancel-btn
    {
        display: inline-block;

        padding: 11px 18px;

        background: white;

        color: #475569;

        border: 1px solid #cbd5e1;

        border-radius: 9px;

        text-decoration: none;

        font-size: 13px;

        font-weight: 600;
    }


    .cancel-btn:hover
    {
        background: #f8fafc;

        color: #172554;
    }


    .delete-confirm-btn
    {
        padding: 11px 20px;

        background: #dc2626;

        color: white;

        border: none;

        border-radius: 9px;

        font-size: 13px;

        font-weight: 600;

        cursor: pointer;
    }


    .delete-confirm-btn:hover
    {
        background: #b91c1c;
    }


    /* ==========================================
       MOBILE
    ========================================== */

    @@media (max-width: 600px)
    {
        .delete-header
        {
            flex-direction: column;

            align-items: flex-start;

            gap: 12px;
        }


        .customer-information
        {
            grid-template-columns: 1fr;
        }


        .full-width
        {
            grid-column: auto;
        }


        .delete-actions
        {
            flex-direction: column;

            align-items: stretch;
        }


        .cancel-btn,
        .delete-confirm-btn
        {
            width: 100%;

            box-sizing: border-box;

            text-align: center;
        }


        .delete-actions form
        {
            width: 100%;
        }
    }

</style>