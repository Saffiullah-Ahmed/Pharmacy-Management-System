@model PharmacyManagementSystem.Web.Models.RegisterPharmacyViewModel

@{
    ViewData["Title"] = "Register Pharmacy";
}


<div class="register-page">

    <div class="auth-card">

        <!-- ========================================================
             ICON
        ========================================================= -->

        <div class="register-icon">
            🏥
        </div>


        <!-- ========================================================
             TITLE
        ========================================================= -->

        <h1>
            Register Your Pharmacy
        </h1>

        <p class="auth-description">
            Create your pharmacy and administrator account.
        </p>


        <!-- ========================================================
             VALIDATION SUMMARY
        ========================================================= -->

        <div asp-validation-summary="ModelOnly"
             class="validation-summary">
        </div>


        <!-- ========================================================
             REGISTRATION FORM
        ========================================================= -->

        <form asp-action="Register"
              method="post">

            @Html.AntiForgeryToken()


            <!-- ====================================================
                 PHARMACY INFORMATION
            ===================================================== -->

            <div class="section-title">
                Pharmacy Information
            </div>


            <!-- PHARMACY NAME -->

            <div class="form-group">

                <label asp-for="PharmacyName">
                    Pharmacy Name
                </label>

                <input asp-for="PharmacyName"
                       class="form-control"
                       placeholder="Enter pharmacy name"
                       autocomplete="organization" />

                <span asp-validation-for="PharmacyName"
                      class="field-validation">
                </span>

            </div>


            <!-- PHONE -->

            <div class="form-group">

                <label asp-for="Phone">
                    Phone
                </label>

                <input asp-for="Phone"
                       class="form-control"
                       placeholder="0300-0000000"
                       autocomplete="tel" />

                <span asp-validation-for="Phone"
                      class="field-validation">
                </span>

            </div>


            <!-- ADDRESS -->

            <div class="form-group">

                <label asp-for="Address">
                    Address
                </label>

                <textarea asp-for="Address"
                          class="form-control"
                          rows="3"
                          placeholder="Enter pharmacy address"></textarea>

                <span asp-validation-for="Address"
                      class="field-validation">
                </span>

            </div>


            <!-- ====================================================
                 ADMINISTRATOR ACCOUNT
            ===================================================== -->

            <div class="section-title">
                Administrator Account
            </div>


            <!-- USERNAME -->

            <div class="form-group">

                <label asp-for="AdminUsername">
                    Admin Username
                </label>

                <input asp-for="AdminUsername"
                       class="form-control"
                       placeholder="Create admin username"
                       autocomplete="username" />

                <span asp-validation-for="AdminUsername"
                      class="field-validation">
                </span>

            </div>


            <!-- PASSWORD -->

            <div class="form-group">

                <label asp-for="Password">
                    Password
                </label>

                <input asp-for="Password"
                       class="form-control"
                       placeholder="Create strong password"
                       autocomplete="new-password" />

                <span asp-validation-for="Password"
                      class="field-validation">
                </span>

                <small class="password-help">

                    At least 8 characters, including uppercase,
                    lowercase, number and special character.

                </small>

            </div>


            <!-- CONFIRM PASSWORD -->

            <div class="form-group">

                <label asp-for="ConfirmPassword">
                    Confirm Password
                </label>

                <input asp-for="ConfirmPassword"
                       class="form-control"
                       placeholder="Confirm password"
                       autocomplete="new-password" />

                <span asp-validation-for="ConfirmPassword"
                      class="field-validation">
                </span>

            </div>


            <!-- ====================================================
                 REGISTER BUTTON
            ===================================================== -->

            <button type="submit"
                    class="primary-btn">

                🏥 Register Pharmacy

            </button>


            <!-- ====================================================
                 BACK TO LOGIN
            ===================================================== -->

            <a asp-controller="Account"
               asp-action="Login"
               class="secondary-btn">

                ← Back to Login

            </a>

        </form>


        <!-- ========================================================
             FOOTER
        ========================================================= -->

        <div class="auth-footer">

            Already have a pharmacy account?

            <a asp-controller="Account"
               asp-action="Login">

                Login here

            </a>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}


<style>

    /* ============================================================
       PAGE
    ============================================================ */

    .register-page
    {
        min-height: calc(100vh - 100px);

        display: flex;

        align-items: flex-start;

        justify-content: center;

        padding: 35px 20px;
    }


    /* ============================================================
       CARD
    ============================================================ */

    .auth-card
    {
        width: 100%;

        max-width: 520px;

        background: white;

        border: 1px solid #e2e8f0;

        border-radius: 16px;

        padding: 32px;

        box-shadow:
            0 8px 30px
            rgba(15, 23, 42, .07);

        box-sizing: border-box;
    }


    /* ============================================================
       ICON
    ============================================================ */

    .register-icon
    {
        width: 54px;

        height: 54px;

        display: flex;

        align-items: center;

        justify-content: center;

        margin: 0 auto 16px;

        background: #eff6ff;

        border-radius: 14px;

        font-size: 26px;
    }


    /* ============================================================
       TITLE
    ============================================================ */

    .auth-card h1
    {
        margin: 0;

        text-align: center;

        color: #172554;

        font-size: 25px;

        font-weight: 700;
    }


    .auth-description
    {
        margin: 7px 0 28px;

        text-align: center;

        color: #64748b;

        font-size: 13px;
    }


    /* ============================================================
       SECTION TITLE
    ============================================================ */

    .section-title
    {
        margin: 24px 0 15px;

        padding-bottom: 8px;

        border-bottom: 1px solid #e2e8f0;

        color: #172554;

        font-size: 14px;

        font-weight: 700;
    }


    /* ============================================================
       FORM
    ============================================================ */

    .form-group
    {
        margin-bottom: 18px;
    }


    .form-group label
    {
        display: block;

        margin-bottom: 7px;

        color: #334155;

        font-size: 12px;

        font-weight: 700;
    }


    .form-control
    {
        width: 100%;

        box-sizing: border-box;

        padding: 11px 12px;

        border: 1px solid #cbd5e1;

        border-radius: 9px;

        background: white;

        color: #172554;

        outline: none;

        font-size: 13px;

        transition: .2s;
    }


    .form-control:focus
    {
        border-color: #2563eb;

        box-shadow:
            0 0 0 3px
            rgba(37, 99, 235, .10);
    }


    textarea.form-control
    {
        resize: vertical;

        min-height: 85px;
    }


    /* ============================================================
       PASSWORD HELP
    ============================================================ */

    .password-help
    {
        display: block;

        margin-top: 6px;

        color: #94a3b8;

        font-size: 10px;

        line-height: 1.5;
    }


    /* ============================================================
       VALIDATION
    ============================================================ */

    .field-validation
    {
        display: block;

        margin-top: 5px;

        color: #dc2626;

        font-size: 11px;
    }


    .validation-summary
    {
        margin-bottom: 15px;

        color: #dc2626;

        font-size: 12px;
    }


    .validation-summary:empty
    {
        display: none;
    }


    /* ============================================================
       BUTTON
    ============================================================ */

    .primary-btn
    {
        width: 100%;

        margin-top: 8px;

        padding: 12px 18px;

        border: none;

        border-radius: 9px;

        background: #2563eb;

        color: white;

        font-size: 13px;

        font-weight: 700;

        cursor: pointer;

        transition: .2s;
    }


    .primary-btn:hover
    {
        background: #1d4ed8;
    }


    /* ============================================================
       SECONDARY BUTTON
    ============================================================ */

    .secondary-btn
    {
        display: block;

        width: 100%;

        box-sizing: border-box;

        margin-top: 10px;

        padding: 11px 18px;

        border: 1px solid #cbd5e1;

        border-radius: 9px;

        background: white;

        color: #475569;

        text-align: center;

        text-decoration: none;

        font-size: 13px;

        font-weight: 600;
    }


    .secondary-btn:hover
    {
        background: #f8fafc;

        color: #172554;
    }


    /* ============================================================
       FOOTER
    ============================================================ */

    .auth-footer
    {
        margin-top: 22px;

        padding-top: 18px;

        border-top: 1px solid #e2e8f0;

        text-align: center;

        color: #64748b;

        font-size: 12px;
    }


    .auth-footer a
    {
        color: #2563eb;

        font-weight: 600;

        text-decoration: none;
    }


    .auth-footer a:hover
    {
        text-decoration: underline;
    }


    /* ============================================================
       MOBILE
    ============================================================ */

    @@media (max-width: 600px)
    {
        .register-page
        {
            padding: 20px 10px;
        }


        .auth-card
        {
            padding: 24px 20px;
        }
    }

</style>