@model PharmacyManagementSystem.Web.Models.Medicine

@{
    ViewData["Title"] = "Edit Medicine";
}

<div class="medicine-form-page">

    <!-- ==========================================
         PAGE HEADER
    ========================================== -->

    <div class="medicine-form-header">

        <div>

            <h1>Edit Medicine</h1>

            <p>
                Update medicine information and inventory details
            </p>

        </div>

        <a asp-controller="Medicine"
           asp-action="Index"
           class="back-medicine-btn">

            ← Back to Medicines

        </a>

    </div>


    <!-- ==========================================
         FORM CARD
    ========================================== -->

    <div class="medicine-form-card">

        <div class="form-card-header">

            <div class="form-icon">
                💊
            </div>

            <div>

                <h2>Medicine Information</h2>

                <p>
                    Update the details below
                </p>

            </div>

        </div>


        <!-- ==========================================
             VALIDATION
        ========================================== -->

        <div asp-validation-summary="ModelOnly"
             class="validation-summary">
        </div>


        <!-- ==========================================
             EDIT FORM
        ========================================== -->

        <form asp-controller="Medicine"
              asp-action="Edit"
              method="post">

            @Html.AntiForgeryToken()


            <!-- SYSTEM ID MUST NEVER CHANGE -->

            <input type="hidden"
                   asp-for="Id" />


            <div class="medicine-form-grid">


                <!-- ==========================================
                     SYSTEM ID - DISPLAY ONLY
                ========================================== -->

                <div class="form-group">

                    <label>
                        System Medicine ID
                    </label>

                    <input type="text"
                           class="form-control"
                           value="#@Model.Id"
                           readonly />

                    <small class="form-help">
                        This ID is automatically generated by the system
                        and cannot be changed.
                    </small>

                </div>


                <!-- ==========================================
                     COMPANY MEDICINE ID
                ========================================== -->

                <div class="form-group">

                    <label asp-for="CompanyMedicineId">
                        Company Medicine ID
                    </label>

                    <input asp-for="CompanyMedicineId"
                           class="form-control"
                           placeholder="Example: MED-45821" />

                    <small class="form-help">
                        Optional. ID/code provided by the company.
                    </small>

                    <span asp-validation-for="CompanyMedicineId"
                          class="validation-message">
                    </span>

                </div>


                <!-- ==========================================
                     MEDICINE NAME
                ========================================== -->

                <div class="form-group">

                    <label asp-for="Name">
                        Medicine Name *
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Enter medicine name"
                           required />

                    <span asp-validation-for="Name"
                          class="validation-message">
                    </span>

                </div>


                <!-- ==========================================
                     QUANTITY
                ========================================== -->

                <div class="form-group">

                    <label asp-for="Quantity">
                        Quantity *
                    </label>

                    <input asp-for="Quantity"
                           type="number"
                           min="0"
                           class="form-control"
                           required />

                    <span asp-validation-for="Quantity"
                          class="validation-message">
                    </span>

                </div>


                <!-- ==========================================
                     PRICE
                ========================================== -->

                <div class="form-group">

                    <label asp-for="Price">
                        Price *
                    </label>

                    <input asp-for="Price"
                           type="number"
                           step="0.01"
                           min="0.01"
                           class="form-control"
                           required />

                    <span asp-validation-for="Price"
                          class="validation-message">
                    </span>

                </div>


                <!-- ==========================================
                     CATEGORY
                ========================================== -->

                <div class="form-group">

                    <label asp-for="Category">
                        Category
                    </label>

                    <input asp-for="Category"
                           class="form-control"
                           placeholder="Example: Antibiotic" />

                    <span asp-validation-for="Category"
                          class="validation-message">
                    </span>

                </div>


                <!-- ==========================================
                     MG
                ========================================== -->

                <div class="form-group">

                    <label asp-for="Mg">
                        MG / Strength
                    </label>

                    <input asp-for="Mg"
                           class="form-control"
                           placeholder="Example: 500mg" />

                    <span asp-validation-for="Mg"
                          class="validation-message">
                    </span>

                </div>


                <!-- ==========================================
                     COMPANY
                ========================================== -->

                <div class="form-group">

                    <label asp-for="Company">
                        Company
                    </label>

                    <input asp-for="Company"
                           class="form-control"
                           placeholder="Example: GSK" />

                    <span asp-validation-for="Company"
                          class="validation-message">
                    </span>

                </div>


                <!-- ==========================================
                     FORMULA
                ========================================== -->

                <div class="form-group">

                    <label asp-for="Formula">
                        Formula
                    </label>

                    <input asp-for="Formula"
                           class="form-control"
                           placeholder="Example: Paracetamol" />

                    <span asp-validation-for="Formula"
                          class="validation-message">
                    </span>

                </div>


                <!-- ==========================================
                     EXPIRY
                ========================================== -->

                <div class="form-group">

                    <label asp-for="ExpiryDate">
                        Expiry Date
                    </label>

                    <input asp-for="ExpiryDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="ExpiryDate"
                          class="validation-message">
                    </span>

                </div>

            </div>


            <!-- ==========================================
                 ACTIONS
            ========================================== -->

            <div class="form-actions">

                <a asp-controller="Medicine"
                   asp-action="Index"
                   class="cancel-btn">

                    Cancel

                </a>

                <button type="submit"
                        class="save-medicine-btn">

                    Save Changes

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}