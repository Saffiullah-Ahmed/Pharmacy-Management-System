@model PharmacyManagementSystem.Web.Models.Medicine

@{
    ViewData["Title"] = "Delete Medicine";
}

<div class="delete-page">

    <!-- ==========================================
         PAGE HEADER
    ========================================== -->

    <div class="delete-header">

        <div class="delete-header-left">

            <div class="header-icon">
                🗑
            </div>

            <div>
                <h1>Delete Medicine</h1>

                <p>
                    Review the medicine information before permanently deleting it.
                </p>
            </div>

        </div>

        <a asp-controller="Medicine"
           asp-action="Index"
           class="back-medicine-btn">

            ← Back to Medicines

        </a>

    </div>


    <!-- ==========================================
         DELETE CARD
    ========================================== -->

    <div class="delete-card">

        <!-- ==========================================
             CARD HEADER
        ========================================== -->

        <div class="delete-card-header">

            <div class="delete-warning-icon">
                ⚠
            </div>

            <div>

                <h2>
                    Confirm Deletion
                </h2>

                <p>
                    You are about to permanently remove this medicine from the current pharmacy.
                </p>

            </div>

        </div>


        <!-- ==========================================
             MEDICINE INFORMATION
        ========================================== -->

        <div class="delete-details">

            <!-- ==========================================
                 LEFT MEDICINE SUMMARY
            ========================================== -->

            <div class="medicine-summary">

                <div class="medicine-pill">
                    💊
                </div>

                <span class="summary-label">
                    MEDICINE NAME
                </span>

                <strong class="medicine-name">
                    @Model.Name
                </strong>

                <div class="summary-divider"></div>

                <span class="summary-label">
                    MEDICINE ID
                </span>

                <strong class="medicine-id">
                    @Model.Id
                </strong>

            </div>


            <!-- ==========================================
                 RIGHT INFORMATION GRID
            ========================================== -->

            <div class="medicine-information">

                <!-- CATEGORY -->

                <div class="detail-item">

                    <span>
                        CATEGORY
                    </span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.Category)
                            ? "Not provided"
                            : Model.Category)
                    </strong>

                </div>


                <!-- COMPANY -->

                <div class="detail-item">

                    <span>
                        COMPANY
                    </span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.Company)
                            ? "Not provided"
                            : Model.Company)
                    </strong>

                </div>


                <!-- FORMULA -->

                <div class="detail-item">

                    <span>
                        FORMULA
                    </span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.Formula)
                            ? "Not provided"
                            : Model.Formula)
                    </strong>

                </div>


                <!-- STRENGTH -->

                <div class="detail-item">

                    <span>
                        STRENGTH / MG
                    </span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.Mg)
                            ? "Not provided"
                            : Model.Mg)
                    </strong>

                </div>


                <!-- PRICE -->

                <div class="detail-item">

                    <span>
                        PRICE
                    </span>

                    <strong class="price-value">
                        Rs. @Model.Price.ToString("N2")
                    </strong>

                </div>


                <!-- QUANTITY -->

                <div class="detail-item">

                    <span>
                        CURRENT QUANTITY
                    </span>

                    <strong>
                        @Model.Quantity
                    </strong>

                </div>


                <!-- EXPIRY DATE -->

                <div class="detail-item">

                    <span>
                        EXPIRY DATE
                    </span>

                    <strong>
                        @(Model.ExpiryDate.HasValue
                            ? Model.ExpiryDate.Value.ToString("dd/MM/yyyy")
                            : "Not provided")
                    </strong>

                </div>


                <!-- CREATED AT -->

                <div class="detail-item">

                    <span>
                        CREATED AT
                    </span>

                    <strong>
                        @Model.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")
                    </strong>

                </div>


                <!-- LAST EDITED -->

                <div class="detail-item">

                    <span>
                        LAST EDITED
                    </span>

                    <strong>
                        @(Model.EditedAt.HasValue
                            ? Model.EditedAt.Value.ToString("dd/MM/yyyy hh:mm tt")
                            : "Never")
                    </strong>

                </div>

            </div>

        </div>


        <!-- ==========================================
             ACTIONS
        ========================================== -->

        <div class="delete-actions">

            <!-- CANCEL -->

            <a asp-controller="Medicine"
               asp-action="Index"
               class="delete-cancel-btn">

                Cancel

            </a>


            <!-- ==========================================
                 DELETE FORM

                 No JavaScript confirmation.
                 The page itself is the confirmation.
            ========================================== -->

            <form asp-controller="Medicine"
                  asp-action="DeleteConfirmed"
                  method="post"
                  class="delete-form">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <button type="submit"
                        class="delete-confirm-btn">

                    🗑 Delete Medicine

                </button>

            </form>

        </div>

    </div>

</div>


<style>

    /* ==========================================
       PAGE
    ========================================== */

    .delete-page
    {
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
        padding-bottom: 30px;
    }


    /* ==========================================
       PAGE HEADER
    ========================================== */

    .delete-header
    {
        display: flex;
        align-items: center;
        justify-content: space-between;

        margin-bottom: 25px;
    }


    .delete-header-left
    {
        display: flex;
        align-items: center;
        gap: 14px;
    }


    .header-icon
    {
        width: 48px;
        height: 48px;

        display: flex;
        align-items: center;
        justify-content: center;

        background: #fff1f2;
        border: 1px solid #fecdd3;

        border-radius: 11px;

        font-size: 20px;
    }


    .delete-header h1
    {
        margin: 0;

        color: #172554;

        font-size: 28px;
        font-weight: 700;
    }


    .delete-header p
    {
        margin: 5px 0 0;

        color: #64748b;

        font-size: 13px;
    }


    /* ==========================================
       BACK BUTTON
    ========================================== */

    .back-medicine-btn
    {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        padding: 10px 15px;

        background: white;

        border: 1px solid #dbe3ef;
        border-radius: 9px;

        color: #334155;

        font-size: 13px;
        font-weight: 600;

        text-decoration: none;

        transition: .2s;
    }


    .back-medicine-btn:hover
    {
        background: #f8fafc;

        color: #2563eb;

        border-color: #bfdbfe;
    }


    /* ==========================================
       DELETE CARD
    ========================================== */

    .delete-card
    {
        background: white;

        border: 1px solid #e2e8f0;

        border-radius: 15px;

        overflow: hidden;

        box-shadow:
            0 4px 18px
            rgba(15, 23, 42, .05);
    }


    /* ==========================================
       CARD HEADER
    ========================================== */

    .delete-card-header
    {
        display: flex;
        align-items: center;

        gap: 14px;

        padding: 23px 25px;

        background: #fffafa;

        border-bottom: 1px solid #fee2e2;
    }


    .delete-warning-icon
    {
        width: 44px;
        height: 44px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        background: #fff1f2;

        border: 1px solid #fecaca;

        border-radius: 10px;

        color: #dc2626;

        font-size: 21px;
        font-weight: 700;
    }


    .delete-card-header h2
    {
        margin: 0;

        color: #991b1b;

        font-size: 18px;
        font-weight: 700;
    }


    .delete-card-header p
    {
        margin: 5px 0 0;

        color: #b91c1c;

        font-size: 12px;
    }


    /* ==========================================
       DETAILS CONTAINER
    ========================================== */

    .delete-details
    {
        display: grid;

        grid-template-columns: 300px 1fr;

        margin: 25px;

        border: 1px solid #dbe3ef;

        border-radius: 12px;

        overflow: hidden;
    }


    /* ==========================================
       MEDICINE SUMMARY
    ========================================== */

    .medicine-summary
    {
        display: flex;

        flex-direction: column;

        align-items: center;
        justify-content: center;

        padding: 30px 20px;

        background: #f8fafc;

        text-align: center;
    }


    .medicine-pill
    {
        width: 52px;
        height: 52px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin-bottom: 17px;

        background: #fff1f2;

        border: 1px solid #fecdd3;

        border-radius: 50%;

        font-size: 23px;
    }


    .summary-label
    {
        color: #64748b;

        font-size: 10px;

        font-weight: 600;

        letter-spacing: .4px;
    }


    .medicine-name
    {
        margin-top: 7px;

        color: #172554;

        font-size: 17px;

        font-weight: 700;

        word-break: break-word;
    }


    .summary-divider
    {
        width: 55px;

        height: 1px;

        margin: 20px 0;

        background: #dbe3ef;
    }


    .medicine-id
    {
        margin-top: 7px;

        color: #2563eb;

        font-size: 16px;

        font-weight: 700;
    }


    /* ==========================================
       INFORMATION GRID
    ========================================== */

    .medicine-information
    {
        display: grid;

        grid-template-columns:
            repeat(3, 1fr);

        background: #e2e8f0;

        gap: 1px;
    }


    .detail-item
    {
        display: flex;

        flex-direction: column;

        justify-content: center;

        min-height: 82px;

        padding: 13px;

        background: white;
    }


    .detail-item span
    {
        margin-bottom: 7px;

        color: #64748b;

        font-size: 9px;

        font-weight: 600;

        letter-spacing: .4px;
    }


    .detail-item strong
    {
        color: #172554;

        font-size: 12px;

        font-weight: 500;

        word-break: break-word;
    }


    .detail-item .price-value
    {
        color: #15803d;

        font-weight: 600;
    }


    /* ==========================================
       ACTION AREA
    ========================================== */

    .delete-actions
    {
        display: flex;

        align-items: center;
        justify-content: flex-end;

        gap: 10px;

        padding: 18px 25px;

        border-top: 1px solid #e2e8f0;

        background: #ffffff;
    }


    /* ==========================================
       DELETE FORM
    ========================================== */

    .delete-form
    {
        margin: 0;
        padding: 0;
    }


    /* ==========================================
       CANCEL BUTTON
    ========================================== */

    .delete-cancel-btn
    {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        padding: 10px 18px;

        background: white;

        border: 1px solid #cbd5e1;

        border-radius: 8px;

        color: #475569;

        font-size: 12px;

        font-weight: 600;

        text-decoration: none;

        transition: .2s;
    }


    .delete-cancel-btn:hover
    {
        background: #f8fafc;

        color: #334155;
    }


    /* ==========================================
       DELETE BUTTON
    ========================================== */

    .delete-confirm-btn
    {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        padding: 10px 18px;

        background: #dc2626;

        border: none;

        border-radius: 8px;

        color: white;

        font-size: 12px;

        font-weight: 600;

        cursor: pointer;

        transition: .2s;
    }


    .delete-confirm-btn:hover
    {
        background: #b91c1c;

        transform: translateY(-1px);
    }


    .delete-confirm-btn:active
    {
        transform: translateY(0);
    }


    /* ==========================================
       MOBILE
    ========================================== */

    @@media (max-width: 750px)
    {
        .delete-header
        {
            flex-direction: column;

            align-items: flex-start;

            gap: 15px;
        }


        .delete-header-left
        {
            width: 100%;
        }


        .back-medicine-btn
        {
            width: 100%;

            box-sizing: border-box;
        }


        .delete-details
        {
            grid-template-columns: 1fr;

            margin: 18px;
        }


        .medicine-information
        {
            grid-template-columns: repeat(2, 1fr);
        }


        .delete-actions
        {
            flex-direction: column;

            align-items: stretch;

            padding: 18px;
        }


        .delete-cancel-btn,
        .delete-confirm-btn
        {
            width: 100%;

            box-sizing: border-box;

            text-align: center;
        }


        .delete-form
        {
            width: 100%;
        }
    }


    /* ==========================================
       SMALL MOBILE
    ========================================== */

    @@media (max-width: 480px)
    {
        .delete-page
        {
            padding: 0 10px 25px;
        }


        .delete-card-header
        {
            padding: 18px;
        }


        .delete-details
        {
            margin: 15px;
        }


        .medicine-information
        {
            grid-template-columns: 1fr;
        }


        .medicine-summary
        {
            padding: 25px 15px;
        }
    }

</style>