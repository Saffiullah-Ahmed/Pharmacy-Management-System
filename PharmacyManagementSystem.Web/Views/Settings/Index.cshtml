@model PharmacyManagementSystem.Web.Models.PharmacySettings

@{
    ViewData["Title"] = "Settings";

    bool isAdmin =
        User.IsInRole("Admin");
}

<div class="settings-page">

    <!-- ==========================================================
         HEADER
    =========================================================== -->

    <div class="settings-header">

        <div>

            <div class="page-title-row">

                <div class="page-title-icon">
                    ⚙️
                </div>

                <div>

                    <h1>
                        Settings
                    </h1>

                    <p>
                        Manage your pharmacy, system preferences and account security
                    </p>

                </div>

            </div>

        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="back-btn">

            ← Back to Dashboard

        </a>

    </div>


    <!-- ==========================================================
         SUCCESS MESSAGE
    =========================================================== -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="message success-message">

            <span class="message-icon">
                ✓
            </span>

            <span>
                @TempData["SuccessMessage"]
            </span>

        </div>
    }


    <!-- ==========================================================
         ERROR MESSAGE
    =========================================================== -->

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="message error-message">

            <span class="message-icon">
                ⚠
            </span>

            <span>
                @TempData["ErrorMessage"]
            </span>

        </div>
    }


    <!-- ==========================================================
         PHARMACY INFORMATION
    =========================================================== -->

    <div class="settings-card">

        <div class="settings-card-header">

            <div class="section-icon pharmacy-icon">
                🏥
            </div>

            <div class="section-heading">

                <h2>
                    Pharmacy Information
                </h2>

                <p>
                    Manage the basic information displayed for your pharmacy.
                </p>

            </div>

            @if (isAdmin)
            {
                <span class="admin-badge">
                    Admin Only
                </span>
            }

        </div>


        @if (isAdmin)
        {
            <form asp-controller="Settings"
                  asp-action="UpdatePharmacy"
                  method="post"
                  id="pharmacySettingsForm">

                @Html.AntiForgeryToken()


                <div class="settings-card-body">

                    <div class="form-grid">

                        <!-- PHARMACY NAME -->

                        <div class="form-group full-width">

                            <label for="PharmacyName">
                                Pharmacy Name
                            </label>

                            <input type="text"
                                   id="PharmacyName"
                                   name="PharmacyName"
                                   value="@Model.PharmacyName"
                                   class="form-control"
                                   maxlength="200"
                                   autocomplete="organization"
                                   required />

                            <small>
                                This name is displayed in the application header.
                            </small>

                        </div>


                        <!-- PHONE -->

                        <div class="form-group">

                            <label for="Phone">
                                Phone Number
                            </label>

                            <input type="text"
                                   id="Phone"
                                   name="Phone"
                                   value="@Model.Phone"
                                   class="form-control"
                                   maxlength="30"
                                   autocomplete="tel"
                                   placeholder="03XX-XXXXXXX" />

                        </div>


                        <!-- ADDRESS -->

                        <div class="form-group">

                            <label for="Address">
                                Pharmacy Address
                            </label>

                            <input type="text"
                                   id="Address"
                                   name="Address"
                                   value="@Model.Address"
                                   class="form-control"
                                   maxlength="255"
                                   autocomplete="street-address"
                                   placeholder="Enter pharmacy address" />

                        </div>

                    </div>

                </div>


                <div class="settings-card-footer">

                    <span class="footer-hint">
                        Changes apply to your pharmacy only.
                    </span>

                    <button type="submit"
                            class="primary-btn">

                        💾 Save Pharmacy Information

                    </button>

                </div>

            </form>
        }
        else
        {
            <div class="settings-card-body">

                <div class="read-only-grid">

                    <div class="info-item">

                        <span>
                            Pharmacy Name
                        </span>

                        <strong>
                            @Model.PharmacyName
                        </strong>

                    </div>


                    <div class="info-item">

                        <span>
                            Phone
                        </span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.Phone)
                                ? "Not provided"
                                : Model.Phone)
                        </strong>

                    </div>


                    <div class="info-item full-width">

                        <span>
                            Address
                        </span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.Address)
                                ? "Not provided"
                                : Model.Address)
                        </strong>

                    </div>

                </div>

                <div class="admin-notice">

                    🔒 Pharmacy information can only be changed by an administrator.

                </div>

            </div>
        }

    </div>


    <!-- ==========================================================
         SYSTEM PREFERENCES
    =========================================================== -->

    <div class="settings-card">

        <div class="settings-card-header">

            <div class="section-icon system-icon">
                ⚙️
            </div>

            <div class="section-heading">

                <h2>
                    System Preferences
                </h2>

                <p>
                    Configure how PharmaCare handles currency, stock alerts and dates.
                </p>

            </div>

        </div>


        <div class="settings-card-body">

            <div class="preference-list">


                <!-- ==================================================
                     CURRENCY
                =================================================== -->

                <div class="preference-row">

                    <div class="preference-info">

                        <div class="preference-icon">
                            💵
                        </div>

                        <div>

                            <strong>
                                Currency
                            </strong>

                            <span>
                                Currency symbol used throughout the pharmacy system.
                            </span>

                        </div>

                    </div>

                    <select name="Currency"
                            form="pharmacySettingsForm"
                            class="setting-select"
                            @(isAdmin ? "" : "disabled")>

                        <option value="Rs."
                                selected="@(Model.Currency == "Rs.")">
                            Rs.
                        </option>

                        <option value="$"
                                selected="@(Model.Currency == "$")">
                            $
                        </option>

                        <option value="€"
                                selected="@(Model.Currency == "€")">
                            €
                        </option>

                        <option value="£"
                                selected="@(Model.Currency == "£")">
                            £
                        </option>

                    </select>

                </div>


                <!-- ==================================================
                     LOW STOCK
                =================================================== -->

                <div class="preference-row">

                    <div class="preference-info">

                        <div class="preference-icon">
                            📦
                        </div>

                        <div>

                            <strong>
                                Low Stock Threshold
                            </strong>

                            <span>
                                Medicines at or below this level can be treated as low stock.
                            </span>

                        </div>

                    </div>

                    <div class="threshold-control">

                        <input type="number"
                               name="LowStockThreshold"
                               form="pharmacySettingsForm"
                               value="@Model.LowStockThreshold"
                               min="1"
                               max="10000"
                               class="setting-input"
                               @(isAdmin ? "" : "disabled") />

                        <span>
                            units
                        </span>

                    </div>

                </div>


                <!-- ==================================================
                     DATE FORMAT
                =================================================== -->

                <div class="preference-row">

                    <div class="preference-info">

                        <div class="preference-icon">
                            📅
                        </div>

                        <div>

                            <strong>
                                Date Format
                            </strong>

                            <span>
                                Date format used by the application.
                            </span>

                        </div>

                    </div>

                    <select name="DateFormat"
                            form="pharmacySettingsForm"
                            class="setting-select"
                            @(isAdmin ? "" : "disabled")>

                        <option value="dd/MM/yyyy"
                                selected="@(Model.DateFormat == "dd/MM/yyyy")">
                            dd/MM/yyyy
                        </option>

                        <option value="MM/dd/yyyy"
                                selected="@(Model.DateFormat == "MM/dd/yyyy")">
                            MM/dd/yyyy
                        </option>

                        <option value="yyyy-MM-dd"
                                selected="@(Model.DateFormat == "yyyy-MM-dd")">
                            yyyy-MM-dd
                        </option>

                    </select>

                </div>

            </div>

        </div>


        @if (isAdmin)
        {
            <div class="settings-card-footer">

                <span class="footer-hint">
                    These preferences belong to this pharmacy.
                </span>

                <button type="submit"
                        form="pharmacySettingsForm"
                        class="secondary-save-btn">

                    💾 Save Preferences

                </button>

            </div>
        }
        else
        {
            <div class="settings-card-footer">

                <span class="footer-hint">
                    Contact an administrator to change these preferences.
                </span>

            </div>
        }

    </div>


    <!-- ==========================================================
         ACCOUNT & SECURITY
    =========================================================== -->

    <div class="settings-card">

        <div class="settings-card-header">

            <div class="section-icon security-icon">
                🔐
            </div>

            <div class="section-heading">

                <h2>
                    Account & Security
                </h2>

                <p>
                    Manage your personal login and account security.
                </p>

            </div>

        </div>


        <div class="settings-card-body">

            <div class="account-panel">

                <div class="account-avatar">
                    👤
                </div>

                <div class="account-details">

                    <strong>
                        @User.Identity?.Name
                    </strong>

                    <span>
                        @User.FindFirst(
                            System.Security.Claims.ClaimTypes.Role
                        )?.Value
                    </span>

                    <small>
                        @Model.PharmacyName
                    </small>

                </div>

            </div>


            <div class="security-option">

                <div class="security-option-info">

                    <strong>
                        Change Password
                    </strong>

                    <span>
                        Update your current login password and improve account security.
                    </span>

                </div>

                <a asp-controller="Settings"
                   asp-action="ChangePassword"
                   class="option-btn">

                    🔐 Change Password

                </a>

            </div>

        </div>

    </div>


    <!-- ==========================================================
         USER MANAGEMENT
         ADMIN ONLY
    =========================================================== -->

    @if (isAdmin)
    {
        <div class="settings-card">

            <div class="settings-card-header">

                <div class="section-icon users-icon">
                    👥
                </div>

                <div class="section-heading">

                    <h2>
                        User Management
                    </h2>

                    <p>
                        Manage staff accounts and control their permissions.
                    </p>

                </div>

                <span class="admin-badge">
                    Admin Only
                </span>

            </div>


            <div class="settings-card-body">

                <div class="user-management-panel">

                    <div class="user-management-icon">
                        👤
                    </div>

                    <div class="user-management-content">

                        <strong>
                            Manage Staff Accounts
                        </strong>

                        <p>
                            Create staff accounts, activate or deactivate users,
                            and assign permissions for medicines, sales, stock
                            and reports.
                        </p>

                    </div>

                    <a asp-controller="UserManagement"
                       asp-action="Index"
                       class="manage-users-btn">

                        Manage Users →

                    </a>

                </div>

            </div>

        </div>
    }


    <!-- ==========================================================
         ABOUT PHARMACARE
    =========================================================== -->

    <div class="settings-card">

        <div class="settings-card-header">

            <div class="section-icon about-icon">
                ℹ️
            </div>

            <div class="section-heading">

                <h2>
                    About PharmaCare
                </h2>

                <p>
                    Application and system information.
                </p>

            </div>

        </div>


        <div class="about-grid">

            <div class="about-item">

                <span>
                    Software
                </span>

                <strong>
                    PharmaCare
                </strong>

            </div>


            <div class="about-item">

                <span>
                    Version
                </span>

                <strong>
                    1.0.0
                </strong>

            </div>


            <div class="about-item">

                <span>
                    Platform
                </span>

                <strong>
                    ASP.NET Core
                </strong>

            </div>


            <div class="about-item">

                <span>
                    Database
                </span>

                <strong>
                    MySQL
                </strong>

            </div>

        </div>

    </div>


    <!-- ==========================================================
         FOOTER NOTE
    =========================================================== -->

    <div class="settings-footer-note">

        <span>
            PharmaCare Management System
        </span>

        <span>
            Pharmacy ID: @Model.PharmacyId
        </span>

    </div>

</div>


<style>

    /* ============================================================
       PAGE
    ============================================================ */

    .settings-page
    {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        padding: 4px 0 40px;
        box-sizing: border-box;
    }


    /* ============================================================
       HEADER
    ============================================================ */

    .settings-header
    {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 22px;
    }


    .page-title-row
    {
        display: flex;
        align-items: center;
        gap: 14px;
    }


    .page-title-icon
    {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 12px;
        font-size: 22px;
        flex-shrink: 0;
    }


    .settings-header h1
    {
        margin: 0;
        color: #172554;
        font-size: 30px;
        font-weight: 700;
        letter-spacing: -.4px;
    }


    .settings-header p
    {
        margin: 5px 0 0;
        color: #64748b;
        font-size: 13px;
    }


    .back-btn
    {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 15px;
        background: white;
        color: #475569;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
        transition: .2s;
    }


    .back-btn:hover
    {
        background: #f8fafc;
        color: #172554;
        border-color: #cbd5e1;
    }


    /* ============================================================
       MESSAGES
    ============================================================ */

    .message
    {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 15px;
        margin-bottom: 16px;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 600;
    }


    .message-icon
    {
        font-size: 15px;
    }


    .success-message
    {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #15803d;
    }


    .error-message
    {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #dc2626;
    }


    /* ============================================================
       CARD
    ============================================================ */

    .settings-card
    {
        width: 100%;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 15px;
        margin-bottom: 18px;
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(15,23,42,.045);
    }


    .settings-card-header
    {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 18px 21px;
        border-bottom: 1px solid #e2e8f0;
    }


    .section-icon
    {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        font-size: 20px;
        flex-shrink: 0;
    }


    .pharmacy-icon
    {
        background: #eff6ff;
    }


    .system-icon
    {
        background: #fff7ed;
    }


    .security-icon
    {
        background: #f0fdf4;
    }


    .users-icon
    {
        background: #f5f3ff;
    }


    .about-icon
    {
        background: #f8fafc;
    }


    .section-heading
    {
        min-width: 0;
        flex: 1;
    }


    .section-heading h2
    {
        margin: 0;
        color: #172554;
        font-size: 17px;
        font-weight: 750;
    }


    .section-heading p
    {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 11px;
        line-height: 1.5;
    }


    .admin-badge
    {
        padding: 5px 9px;
        background: #fff7ed;
        border: 1px solid #fed7aa;
        color: #c2410c;
        border-radius: 6px;
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
        white-space: nowrap;
    }


    .settings-card-body
    {
        padding: 21px;
    }


    .settings-card-footer
    {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 15px 21px;
        border-top: 1px solid #e2e8f0;
        background: #fafcff;
    }


    .footer-hint
    {
        color: #94a3b8;
        font-size: 10px;
    }


    /* ============================================================
       FORM
    ============================================================ */

    .form-grid
    {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }


    .full-width
    {
        grid-column: 1 / -1;
    }


    .form-group
    {
        min-width: 0;
    }


    .form-group label
    {
        display: block;
        margin-bottom: 7px;
        color: #334155;
        font-size: 11px;
        font-weight: 750;
    }


    .form-control
    {
        width: 100%;
        box-sizing: border-box;
        padding: 11px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        outline: none;
        background: white;
        color: #172554;
        font-size: 12px;
        transition: .2s;
    }


    .form-control:focus
    {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37,99,235,.10);
    }


    .form-group small
    {
        display: block;
        margin-top: 5px;
        color: #94a3b8;
        font-size: 10px;
    }


    /* ============================================================
       BUTTONS
    ============================================================ */

    .primary-btn,
    .secondary-save-btn
    {
        padding: 10px 15px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s;
    }


    .primary-btn
    {
        background: #2563eb;
        color: white;
        border: 1px solid #2563eb;
    }


    .primary-btn:hover
    {
        background: #1d4ed8;
        border-color: #1d4ed8;
    }


    .secondary-save-btn
    {
        background: white;
        color: #2563eb;
        border: 1px solid #bfdbfe;
    }


    .secondary-save-btn:hover
    {
        background: #eff6ff;
    }


    /* ============================================================
       READ ONLY
    ============================================================ */

    .read-only-grid
    {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 13px;
    }


    .info-item
    {
        padding: 13px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
    }


    .info-item span
    {
        display: block;
        color: #94a3b8;
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
    }


    .info-item strong
    {
        display: block;
        margin-top: 5px;
        color: #172554;
        font-size: 12px;
        font-weight: 700;
    }


    .admin-notice
    {
        margin-top: 15px;
        padding: 10px 12px;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 8px;
        color: #92400e;
        font-size: 10px;
        font-weight: 600;
    }


    /* ============================================================
       PREFERENCES
    ============================================================ */

    .preference-list
    {
        display: flex;
        flex-direction: column;
    }


    .preference-row
    {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 15px 0;
        border-bottom: 1px solid #f1f5f9;
    }


    .preference-row:first-child
    {
        padding-top: 0;
    }


    .preference-row:last-child
    {
        padding-bottom: 0;
        border-bottom: none;
    }


    .preference-info
    {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
    }


    .preference-icon
    {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-size: 15px;
        flex-shrink: 0;
    }


    .preference-info strong
    {
        display: block;
        color: #172554;
        font-size: 12px;
    }


    .preference-info span
    {
        display: block;
        margin-top: 3px;
        color: #64748b;
        font-size: 10px;
        line-height: 1.4;
    }


    .setting-select,
    .setting-input
    {
        padding: 8px 10px;
        border: 1px solid #cbd5e1;
        border-radius: 7px;
        background: white;
        color: #334155;
        font-size: 11px;
        outline: none;
    }


    .setting-select
    {
        min-width: 125px;
    }


    .setting-input
    {
        width: 90px;
        box-sizing: border-box;
    }


    .setting-select:focus,
    .setting-input:focus
    {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37,99,235,.10);
    }


    .setting-select:disabled,
    .setting-input:disabled
    {
        background: #f8fafc;
        color: #64748b;
        cursor: not-allowed;
    }


    .threshold-control
    {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #94a3b8;
        font-size: 10px;
        white-space: nowrap;
    }


    /* ============================================================
       ACCOUNT
    ============================================================ */

    .account-panel
    {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 13px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        margin-bottom: 15px;
    }


    .account-avatar
    {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border: 1px solid #dbeafe;
        border-radius: 9px;
        font-size: 19px;
        flex-shrink: 0;
    }


    .account-details
    {
        display: flex;
        flex-direction: column;
    }


    .account-details strong
    {
        color: #172554;
        font-size: 13px;
    }


    .account-details span
    {
        margin-top: 2px;
        color: #2563eb;
        font-size: 10px;
        font-weight: 700;
    }


    .account-details small
    {
        margin-top: 3px;
        color: #94a3b8;
        font-size: 10px;
    }


    .security-option
    {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding-top: 15px;
        border-top: 1px solid #f1f5f9;
    }


    .security-option-info strong
    {
        display: block;
        color: #172554;
        font-size: 12px;
    }


    .security-option-info span
    {
        display: block;
        margin-top: 3px;
        color: #64748b;
        font-size: 10px;
    }


