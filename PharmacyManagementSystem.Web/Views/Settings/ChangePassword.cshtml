@{
    ViewData["Title"] = "Change Password";
}

<div class="password-page">

    <!-- ==========================================================
         HEADER
    =========================================================== -->

    <div class="password-header">

        <div>

            <div class="title-row">

                <div class="title-icon">
                    🔐
                </div>

                <div>

                    <h1>
                        Change Password
                    </h1>

                    <p>
                        Update your PharmaCare account password.
                    </p>

                </div>

            </div>

        </div>

        <a asp-controller="Settings"
           asp-action="Index"
           class="back-button">

            ← Back to Settings

        </a>

    </div>


    <!-- ==========================================================
         SUCCESS
    =========================================================== -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="message success-message">

            <span>
                ✓
            </span>

            <span>
                @TempData["SuccessMessage"]
            </span>

        </div>
    }


    <!-- ==========================================================
         ERROR
    =========================================================== -->

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="message error-message">

            <span>
                ⚠
            </span>

            <span>
                @TempData["ErrorMessage"]
            </span>

        </div>
    }


    <!-- ==========================================================
         PASSWORD CARD
    =========================================================== -->

    <div class="password-card">

        <div class="card-header">

            <div class="card-icon">
                🔑
            </div>

            <div>

                <h2>
                    Account Security
                </h2>

                <p>
                    Use a strong password that you do not use elsewhere.
                </p>

            </div>

        </div>


        <form asp-controller="Settings"
              asp-action="ChangePassword"
              method="post"
              id="passwordForm">

            @Html.AntiForgeryToken()


            <!-- ==================================================
                 CURRENT PASSWORD
            =================================================== -->

            <div class="form-group">

                <label for="currentPassword">
                    Current Password
                </label>

                <input type="password"
                       id="currentPassword"
                       name="currentPassword"
                       class="form-control"
                       autocomplete="current-password"
                       required />

            </div>


            <!-- ==================================================
                 NEW PASSWORD
            =================================================== -->

            <div class="form-group">

                <label for="newPassword">
                    New Password
                </label>

                <input type="password"
                       id="newPassword"
                       name="newPassword"
                       class="form-control"
                       autocomplete="new-password"
                       minlength="8"
                       required />

                <div class="password-rules">

                    <span id="ruleLength">
                        ○ At least 8 characters
                    </span>

                    <span id="ruleUpper">
                        ○ One uppercase letter
                    </span>

                    <span id="ruleLower">
                        ○ One lowercase letter
                    </span>

                    <span id="ruleNumber">
                        ○ One number
                    </span>

                    <span id="ruleSpecial">
                        ○ One special character
                    </span>

                </div>

            </div>


            <!-- ==================================================
                 CONFIRM PASSWORD
            =================================================== -->

            <div class="form-group">

                <label for="confirmPassword">
                    Confirm New Password
                </label>

                <input type="password"
                       id="confirmPassword"
                       name="confirmPassword"
                       class="form-control"
                       autocomplete="new-password"
                       minlength="8"
                       required />

                <small id="matchMessage">
                    Enter the password again to confirm it.
                </small>

            </div>


            <!-- ==================================================
                 ACTIONS
            =================================================== -->

            <div class="form-actions">

                <a asp-controller="Settings"
                   asp-action="Index"
                   class="cancel-button">

                    Cancel

                </a>

                <button type="submit"
                        class="primary-button">

                    🔐 Change Password

                </button>

            </div>

        </form>

    </div>


    <!-- ==========================================================
         SECURITY NOTE
    =========================================================== -->

    <div class="security-note">

        <div class="security-note-icon">
            🛡️
        </div>

        <div>

            <strong>
                Security recommendation
            </strong>

            <p>
                Never share your password with other staff members.
                Each user should have their own account and permissions.
            </p>

        </div>

    </div>

</div>


<script>

    const newPassword =
        document.getElementById("newPassword");

    const confirmPassword =
        document.getElementById("confirmPassword");

    const matchMessage =
        document.getElementById("matchMessage");


    function updatePasswordRules()
    {
        const password =
            newPassword.value;


        updateRule(
            "ruleLength",
            password.length >= 8,
            "At least 8 characters"
        );


        updateRule(
            "ruleUpper",
            /[A-Z]/.test(password),
            "One uppercase letter"
        );


        updateRule(
            "ruleLower",
            /[a-z]/.test(password),
            "One lowercase letter"
        );


        updateRule(
            "ruleNumber",
            /[0-9]/.test(password),
            "One number"
        );


        updateRule(
            "ruleSpecial",
            /[^A-Za-z0-9]/.test(password),
            "One special character"
        );


        updateMatchMessage();
    }


    function updateRule(
        elementId,
        valid,
        text)
    {
        const element =
            document.getElementById(
                elementId);

        if (valid)
        {
            element.textContent =
                "✓ " + text;

            element.classList.add(
                "rule-valid");
        }
        else
        {
            element.textContent =
                "○ " + text;

            element.classList.remove(
                "rule-valid");
        }
    }


    function updateMatchMessage()
    {
        if (!confirmPassword.value)
        {
            matchMessage.textContent =
                "Enter the password again to confirm it.";

            matchMessage.classList.remove(
                "match-valid");

            return;
        }


        if (newPassword.value ===
            confirmPassword.value)
        {
            matchMessage.textContent =
                "✓ Passwords match.";

            matchMessage.classList.add(
                "match-valid");
        }
        else
        {
            matchMessage.textContent =
                "Passwords do not match.";

            matchMessage.classList.remove(
                "match-valid");
        }
    }


    newPassword.addEventListener(
        "input",
        updatePasswordRules
    );


    confirmPassword.addEventListener(
        "input",
        updateMatchMessage
    );


    document.getElementById(
        "passwordForm")
        ?.addEventListener(
            "submit",
            function (event)
            {
                const password =
                    newPassword.value;

                const confirmation =
                    confirmPassword.value;


                const strong =
                    password.length >= 8 &&
                    /[A-Z]/.test(password) &&
                    /[a-z]/.test(password) &&
                    /[0-9]/.test(password) &&
                    /[^A-Za-z0-9]/.test(password);


                if (!strong)
                {
                    event.preventDefault();

                    alert(
                        "Please meet all password requirements."
                    );

                    return;
                }


                if (password !== confirmation)
                {
                    event.preventDefault();

                    alert(
                        "New passwords do not match."
                    );
                }
            }
        );

</script>


<style>

    /* ============================================================
       PAGE
    ============================================================ */

    .password-page
    {
        width: 100%;
        max-width: 850px;
        margin: 0 auto;
        padding-bottom: 40px;
    }


    /* ============================================================
       HEADER
    ============================================================ */

    .password-header
    {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 22px;
    }


    .title-row
    {
        display: flex;
        align-items: center;
        gap: 13px;
    }


    .title-icon
    {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 11px;
        font-size: 21px;
    }


    .password-header h1
    {
        margin: 0;
        color: #172554;
        font-size: 28px;
        font-weight: 800;
    }


    .password-header p
    {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 12px;
    }


    .back-button
    {
        padding: 10px 15px;
        background: white;
        color: #475569;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }


    .back-button:hover
    {
        background: #f8fafc;
        color: #172554;
    }


    /* ============================================================
       MESSAGES
    ============================================================ */

    .message
    {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 11px 14px;
        margin-bottom: 15px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
    }


    .success-message
    {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #15803d;
    }


    .error-message
    {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #dc2626;
    }


    /* ============================================================
       CARD
    ============================================================ */

    .password-card
    {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 4px 16px rgba(15,23,42,.05);
    }


    .card-header
    {
        display: flex;
        align-items: center;
        gap: 13px;
        padding-bottom: 20px;
        margin-bottom: 22px;
        border-bottom: 1px solid #e2e8f0;
    }


    .card-icon
    {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 10px;
        font-size: 20px;
        flex-shrink: 0;
    }


    .card-header h2
    {
        margin: 0;
        color: #172554;
        font-size: 17px;
    }


    .card-header p
    {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 11px;
    }


    /* ============================================================
       FORM
    ============================================================ */

    .form-group
    {
        margin-bottom: 20px;
    }


    .form-group label
    {
        display: block;
        margin-bottom: 7px;
        color: #334155;
        font-size: 11px;
        font-weight: 750;
    }


    .form-control
    {
        width: 100%;
        box-sizing: border-box;
        padding: 11px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        outline: none;
        background: white;
        color: #172554;
        font-size: 12px;
    }


    .form-control:focus
    {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37,99,235,.10);
    }


    .form-group small
    {
        display: block;
        margin-top: 5px;
        color: #94a3b8;
        font-size: 10px;
    }


    /* ============================================================
       PASSWORD RULES
    ============================================================ */

    .password-rules
    {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 5px 12px;
        margin-top: 9px;
        padding: 11px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
    }


    .password-rules span
    {
        color: #94a3b8;
        font-size: 10px;
    }


    .password-rules .rule-valid
    {
        color: #15803d;
        font-weight: 700;
    }


    .match-valid
    {
        color: #15803d !important;
        font-weight: 700;
    }


    /* ============================================================
       ACTIONS
    ============================================================ */

    .form-actions
    {
        display: flex;
        justify-content: flex-end;
        gap: 9px;
        padding-top: 19px;
        border-top: 1px solid #e2e8f0;
    }


    .cancel-button
    {
        padding: 10px 15px;
        background: white;
        color: #475569;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
    }


    .primary-button
    {
        padding: 10px 16px;
        background: #2563eb;
        color: white;
        border: 1px solid #2563eb;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
    }


    .primary-button:hover
    {
        background: #1d4ed8;
        border-color: #1d4ed8;
    }


    /* ============================================================
       SECURITY NOTE
    ============================================================ */

    .security-note
    {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        margin-top: 15px;
        padding: 13px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
    }


    .security-note-icon
    {
        font-size: 18px;
    }


    .security-note strong
    {
        display: block;
        color: #172554;
        font-size: 11px;
    }


    .security-note p
    {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 10px;
        line-height: 1.5;
    }


    /* ============================================================
       MOBILE
    ============================================================ */

    @@media (max-width: 600px)
    {
        .password-header
        {
            align-items: flex-start;
            flex-direction: column;
        }


        .back-button
        {
            width: 100%;
            box-sizing: border-box;
            text-align: center;
        }


        .password-card
        {
            padding: 19px;
        }


        .password-rules
        {
            grid-template-columns: 1fr;
        }


        .form-actions
        {
            flex-direction: column;
        }


        .cancel-button,
        .primary-button
        {
            width: 100%;
            box-sizing: border-box;
            text-align: center;
        }
    }

</style>