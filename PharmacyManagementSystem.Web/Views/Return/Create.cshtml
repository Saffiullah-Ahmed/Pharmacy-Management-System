@model PharmacyManagementSystem.Web.Models.Sale?

@{
    ViewData["Title"] = "Return Medicine";
}

<div class="return-page">

    <!-- ==========================================================
         HEADER
    ========================================================== -->

    <div class="page-header">

        <div>

            <h1>
                Return Medicine
            </h1>

            <p>
                Process medicine returns using an invoice.
            </p>

        </div>


        <a asp-controller="Sale"
           asp-action="Index"
           class="back-btn">

            ← Sales

        </a>

    </div>


    <!-- ==========================================================
         MESSAGES
    ========================================================== -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-message">

            ✓ @TempData["SuccessMessage"]

        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="error-message">

            ⚠ @TempData["ErrorMessage"]

        </div>
    }


    <!-- ==========================================================
         FIND INVOICE
    ========================================================== -->

    @if (Model == null ||
         Model.Id <= 0)
    {
        <div class="return-card">

            <div class="card-icon">
                ↩
            </div>


            <h2>
                Find Sale
            </h2>


            <p class="card-description">
                Enter the invoice number to find the customer's sale.
            </p>


            <form asp-controller="Return"
                  asp-action="FindInvoice"
                  method="post">

                @Html.AntiForgeryToken()


                <div class="form-group">

                    <label>
                        Invoice Number
                    </label>


                    <input type="text"
                           name="invoiceNumber"
                           class="form-control"
                           placeholder="Example: INV-00007"
                           autocomplete="off"
                           required />

                </div>


                <button type="submit"
                        class="primary-btn">

                    🔍 Find Invoice

                </button>

            </form>

        </div>
    }
    else
    {

        <!-- ======================================================
             SALE INFORMATION
        ====================================================== -->

        <div class="sale-info-card">

            <div class="sale-info-header">

                <div>

                    <span>
                        Invoice Number
                    </span>

                    <strong>
                        @Model.InvoiceNumber
                    </strong>

                </div>


                <div>

                    <span>
                        Sale Date
                    </span>

                    <strong>
                        @Model.SaleDate.ToString("dd/MM/yyyy hh:mm tt")
                    </strong>

                </div>


                <div>

                    <span>
                        Original Total
                    </span>

                    <strong>
                        Rs. @Model.TotalAmount.ToString("N2")
                    </strong>

                </div>


                <div>

                    <span>
                        Original Net
                    </span>

                    <strong>
                        Rs. @Model.NetAmount.ToString("N2")
                    </strong>

                </div>

            </div>

        </div>


        <!-- ======================================================
             RETURN CARD
        ====================================================== -->

        <div class="return-card">

            <div class="card-title">

                <div>

                    <h2>
                        Select Medicines
                    </h2>

                    <p>
                        Enter the quantity you want to return.
                    </p>

                </div>

            </div>


            @if (Model.Items == null ||
                 !Model.Items.Any())
            {

                <div class="empty-return">

                    <div class="empty-icon">
                        ✓
                    </div>


                    <h3>
                        Nothing to Return
                    </h3>


                    <p>
                        All medicines from this sale have already been returned.
                    </p>


                    <a asp-controller="Return"
                       asp-action="Create"
                       class="secondary-btn">

                        Search Another Invoice

                    </a>

                </div>

            }
            else
            {

                <form asp-controller="Return"
                      asp-action="ProcessReturn"
                      method="post"
                      id="returnForm">

                    @Html.AntiForgeryToken()


                    <input type="hidden"
                           name="saleId"
                           value="@Model.Id" />


                    <!-- ==================================================
                         MEDICINE TABLE
                    ================================================== -->

                    <div class="table-wrapper">

                        <table class="return-table">

                            <thead>

                                <tr>

                                    <th>
                                        Medicine
                                    </th>

                                    <th>
                                        Available
                                    </th>

                                    <th>
                                        Unit Price
                                    </th>

                                    <th>
                                        Return Quantity
                                    </th>

                                    <th>
                                        Refund
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @for (
                                    int i = 0;
                                    i < Model.Items.Count;
                                    i++)
                                {

                                    var item =
                                        Model.Items[i];


                                    <tr>

                                        <td>

                                            <strong>
                                                @item.MedicineName
                                            </strong>


                                            <input type="hidden"
                                                   name="items[@i].SaleItemId"
                                                   value="@item.Id" />


                                            <input type="hidden"
                                                   name="items[@i].MedicineId"
                                                   value="@item.MedicineId" />

                                        </td>


                                        <td>

                                            <span class="available-badge">
                                                @item.Quantity
                                            </span>

                                        </td>


                                        <td>

                                            Rs.
                                            @item.UnitPrice.ToString("N2")

                                        </td>


                                        <td>

                                            <input type="number"
                                                   name="items[@i].Quantity"
                                                   class="quantity-input"
                                                   min="0"
                                                   max="@item.Quantity"
                                                   value="0"
                                                   data-price="@item.UnitPrice"
                                                   data-max="@item.Quantity"
                                                   oninput="calculateRefunds(this)" />


                                            <small>
                                                Max: @item.Quantity
                                            </small>

                                        </td>


                                        <td>

                                            <strong class="item-refund">
                                                Rs. 0.00
                                            </strong>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>


                    <!-- ==================================================
                         TOTAL REFUND
                    ================================================== -->

                    <div class="refund-summary">

                        <div>

                            <span>
                                Total Refund
                            </span>

                            <strong id="totalRefund">
                                Rs. 0.00
                            </strong>

                        </div>

                    </div>


                    <!-- ==================================================
                         REASON
                    ================================================== -->

                    <div class="form-group">

                        <label>
                            Return Reason
                        </label>


                        <textarea name="reason"
                                  class="form-control"
                                  rows="3"
                                  maxlength="500"
                                  placeholder="Example: Wrong medicine, damaged package, expired medicine..."></textarea>

                    </div>


                    <!-- ==================================================
                         ACTIONS
                    ================================================== -->

                    <div class="form-actions">

                        <a asp-controller="Sale"
                           asp-action="Index"
                           class="cancel-btn">

                            Cancel

                        </a>


                        <button type="submit"
                                class="return-btn"
                                id="openConfirmModal">

                            ↩ Return Medicine

                        </button>

                    </div>

                </form>
            }

        </div>
    }

</div>


<!-- ==============================================================
     CONFIRMATION MODAL
============================================================== -->

<div id="confirmationModal"
     class="modal-overlay"
     style="display:none;">

    <div class="confirmation-modal">

        <div class="modal-icon">
            ↩
        </div>


        <h2>
            Confirm Medicine Return
        </h2>


        <p>
            Are you sure you want to process this return?
        </p>


        <div class="modal-refund">

            <span>
                Total Refund
            </span>

            <strong id="modalRefund">
                Rs. 0.00
            </strong>

        </div>


        <div class="modal-warning">

            <strong>
                Stock will be restored
            </strong>

            <span>
                The returned medicine quantity will be added back to pharmacy stock.
            </span>

        </div>


        <div class="modal-actions">

            <button type="button"
                    id="cancelModal"
                    class="modal-cancel">

                Cancel

            </button>


            <button type="button"
                    id="confirmReturn"
                    class="modal-confirm">

                Confirm Return

            </button>

        </div>

    </div>

</div>


@section Scripts
{
    <script>

        // ==========================================================
        // CALCULATE REFUNDS
        // ==========================================================

        function calculateRefunds(changedInput)
        {
            const inputs =
                document.querySelectorAll(
                    ".quantity-input"
                );


            let totalRefund = 0;


            inputs.forEach(
                function(input)
                {
                    /*
                     * Normalize leading zeros.
                     *
                     * Example:
                     * 01 -> 1
                     * 001 -> 1
                     */

                    if (
                        input.value !== "" &&
                        /^0+\d+$/.test(input.value)
                    )
                    {
                        input.value =
                            String(
                                parseInt(
                                    input.value,
                                    10
                                )
                            );
                    }


                    let quantity =
                        parseInt(
                            input.value,
                            10
                        );


                    if (isNaN(quantity))
                    {
                        quantity = 0;
                    }


                    const max =
                        parseInt(
                            input.dataset.max,
                            10
                        ) || 0;


                    const price =
                        parseFloat(
                            input.dataset.price
                        ) || 0;


                    if (quantity < 0)
                    {
                        quantity = 0;

                        input.value = "0";
                    }


                    if (quantity > max)
                    {
                        quantity = max;

                        input.value =
                            String(max);
                    }


                    const refund =
                        quantity * price;


                    const row =
                        input.closest("tr");


                    if (row)
                    {
                        const refundElement =
                            row.querySelector(
                                ".item-refund"
                            );


                        if (refundElement)
                        {
                            refundElement.textContent =
                                "Rs. " +
                                refund.toFixed(2);
                        }
                    }


                    totalRefund +=
                        refund;
                }
            );


            const totalElement =
                document.getElementById(
                    "totalRefund"
                );


            if (totalElement)
            {
                totalElement.textContent =
                    "Rs. " +
                    totalRefund.toFixed(2);
            }


            const modalRefund =
                document.getElementById(
                    "modalRefund"
                );


            if (modalRefund)
            {
                modalRefund.textContent =
                    "Rs. " +
                    totalRefund.toFixed(2);
            }


            return totalRefund;
        }


        // ==========================================================
        // ELEMENTS
        // ==========================================================

        const form =
            document.getElementById(
                "returnForm"
            );


        const openButton =
            document.getElementById(
                "openConfirmModal"
            );


        const modal =
            document.getElementById(
                "confirmationModal"
            );


        const cancelModal =
            document.getElementById(
                "cancelModal"
            );


        const confirmReturn =
            document.getElementById(
                "confirmReturn"
            );


        // ==========================================================
        // OPEN MODAL
        // ==========================================================

        if (
            form &&
            openButton &&
            modal
        )
        {
            openButton.addEventListener(
                "click",
                function(event)
                {
                    event.preventDefault();


                    const totalRefund =
                        calculateRefunds();


                    if (totalRefund <= 0)
                    {
                        alert(
                            "Please enter a return quantity for at least one medicine."
                        );

                        return;
                    }


                    modal.style.display =
                        "flex";
                }
            );
        }


        // ==========================================================
        // CANCEL MODAL
        // ==========================================================

        if (
            cancelModal &&
            modal
        )
        {
            cancelModal.addEventListener(
                "click",
                function()
                {
                    modal.style.display =
                        "none";
                }
            );
        }


        // ==========================================================
        // CONFIRM RETURN
        // ==========================================================

        if (
            confirmReturn &&
            form &&
            modal
        )
        {
            confirmReturn.addEventListener(
                "click",
                function()
                {
                    modal.style.display =
                        "none";


                    confirmReturn.disabled =
                        true;


                    confirmReturn.textContent =
                        "Processing...";


                    /*
                     * Native form.submit()
                     * bypasses browser validation,
                     * but server-side validation in
                     * ReturnController/ReturnStorage
                     * remains authoritative.
                     */

                    form.submit();
                }
            );
        }


        // ==========================================================
        // CLOSE MODAL BY CLICKING BACKDROP
        // ==========================================================

        if (modal)
        {
            modal.addEventListener(
                "click",
                function(event)
                {
                    if (
                        event.target ===
                        modal
                    )
                    {
                        modal.style.display =
                            "none";
                    }
                }
            );
        }


        // ==========================================================
        // INITIAL CALCULATION
        // ==========================================================

        document.addEventListener(
            "DOMContentLoaded",
            function()
            {
                calculateRefunds();
            }
        );

    </script>
}


