@model List<PharmacyManagementSystem.Web.Models.Sale>

@{
    ViewData["Title"] = "Sales";

    var returns =
        ViewBag.Returns
        as List<PharmacyManagementSystem.Web.Models.SaleReturn>
        ?? new List<PharmacyManagementSystem.Web.Models.SaleReturn>();


    decimal totalRefund =
        ViewBag.TotalRefund != null
            ? Convert.ToDecimal(ViewBag.TotalRefund)
            : 0;


    decimal totalSales =
        Math.Max(
            0,
            Model.Sum(x => x.TotalAmount) -
            totalRefund);


    decimal totalNetSales =
        Math.Max(
            0,
            Model.Sum(x => x.NetAmount) -
            totalRefund);


    int medicinesSold =
    Model.Sum(
        sale => sale.Items.Sum(
            item => item.Quantity ?? 0));


    decimal totalChange =
        Model.Sum(x => x.ChangeAmount);


    // ============================================================
    // TODAY
    // ============================================================

    int todaySalesCount =
        ViewBag.TodaySalesCount != null
            ? Convert.ToInt32(ViewBag.TodaySalesCount)
            : 0;


    decimal todayGrossSales =
        ViewBag.TodayGrossSales != null
            ? Convert.ToDecimal(ViewBag.TodayGrossSales)
            : 0;


    decimal todayNetSales =
        ViewBag.TodayNetSales != null
            ? Convert.ToDecimal(ViewBag.TodayNetSales)
            : 0;


    decimal todayRefund =
        ViewBag.TodayRefund != null
            ? Convert.ToDecimal(ViewBag.TodayRefund)
            : 0;
}


<div class="sales-page">

    <!-- ==========================================================
         HEADER
    ========================================================== -->

    <div class="page-header">

        <div>

            <h1>Sales</h1>

            <p>
                Manage sales, invoices and medicine returns.
            </p>

        </div>


        <div class="header-actions">

            <a asp-controller="Return"
               asp-action="ReturnHistory"
               class="secondary-btn">

                ↩ Return History

            </a>


            <!-- ==================================================
                 PENDING PAYMENTS
            ================================================== -->

            <a asp-controller="CustomerCredit"
               asp-action="Index"
               class="secondary-btn">

                💰 Pending Payments

            </a>


            <a asp-action="ExportCsv"
               class="secondary-btn">

                ↓ Export CSV

            </a>


            <a asp-action="Create"
               class="primary-btn">

                + New Sale

            </a>

        </div>

    </div>


    <!-- ==========================================================
         MESSAGES
    ========================================================== -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-message">

            ✓ @TempData["SuccessMessage"]

        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="error-message">

            ⚠ @TempData["ErrorMessage"]

        </div>
    }


    <!-- ==========================================================
         TODAY'S SALES
    ========================================================== -->

    <div class="today-section">

        <div class="today-header">

            <div>

                <h2>
                    Today's Sales
                </h2>

                <p>
                    Sales and refunds recorded today.
                </p>

            </div>


            <span class="today-date">
                @DateTime.Today.ToString("dd/MM/yyyy")
            </span>

        </div>


        <div class="today-grid">

            <div class="today-card">

                <span class="today-label">
                    Today's Transactions
                </span>

                <strong>
                    @todaySalesCount
                </strong>

            </div>


            <div class="today-card">

                <span class="today-label">
                    Today's Gross Sales
                </span>

                <strong>
                    Rs. @todayGrossSales.ToString("N2")
                </strong>

            </div>


            <div class="today-card refund-card">

                <span class="today-label">
                    Today's Refunds
                </span>

                <strong>
                    Rs. @todayRefund.ToString("N2")
                </strong>

            </div>


            <div class="today-card">

                <span class="today-label">
                    Today's Net Sales
                </span>

                <strong>
                    Rs. @todayNetSales.ToString("N2")
                </strong>

            </div>

        </div>

    </div>


    <!-- ==========================================================
         OVERALL SUMMARY
    ========================================================== -->

    <div class="summary-grid">

        <div class="summary-card">

            <span class="summary-label">
                Total Sales
            </span>

            <strong>
                @Model.Count
            </strong>

        </div>


        <div class="summary-card">

            <span class="summary-label">
                Gross Sales
            </span>

            <strong>
                Rs. @totalSales.ToString("N2")
            </strong>

        </div>


        <div class="summary-card refund-card">

            <span class="summary-label">
                Refunds
            </span>

            <strong>
                Rs. @totalRefund.ToString("N2")
            </strong>

        </div>


        <div class="summary-card">

            <span class="summary-label">
                Net Sales
            </span>

            <strong>
                Rs. @totalNetSales.ToString("N2")
            </strong>

        </div>


        <div class="summary-card">

            <span class="summary-label">
                Medicines Sold
            </span>

            <strong>
                @medicinesSold
            </strong>

        </div>


        <div class="summary-card">

            <span class="summary-label">
                Change Given
            </span>

            <strong>
                Rs. @totalChange.ToString("N2")
            </strong>

        </div>

    </div>


    <!-- ==========================================================
         SALES HISTORY
    ========================================================== -->

    <div class="sales-card">

        <div class="card-header">

            <div>

                <h2>
                    Sales History
                </h2>

                <p>
                    View sales and invoices for this pharmacy.
                </p>

            </div>


            <div class="search-box">

                <input type="text"
                       id="salesSearch"
                       placeholder="Search invoice..."
                       autocomplete="off"
                       oninput="searchSales()" />

            </div>

        </div>


        <div class="table-wrapper">

            <table class="sales-table">

                <thead>

                    <tr>

                        <th>#</th>

                        <th>Invoice</th>

                        <th>Date & Time</th>

                        <th>Medicines</th>

                        <th>Original Gross</th>

                        <th>Discount</th>

                        <th>Original Net</th>

                        <th>Refund</th>

                        <th>Actual Gross</th>

                        <th>Actual Net</th>

                        <th>Received</th>

                        <th>Change</th>

                        <th>Action</th>

                    </tr>

                </thead>


                <tbody id="salesTableBody">

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="13"
                                class="empty-row">

                                No sales found.

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (
                            var sale in
                            Model.OrderByDescending(
                                x => x.SaleDate))
                        {
                            decimal saleRefund =
                                returns
                                    .Where(
                                        r =>
                                            r.SaleId ==
                                            sale.Id)
                                    .Sum(
                                        r =>
                                            r.TotalRefund);


                            decimal actualGross =
                                Math.Max(
                                    0,
                                    sale.TotalAmount -
                                    saleRefund);


                            decimal actualNet =
                                Math.Max(
                                    0,
                                    sale.NetAmount -
                                    saleRefund);


                            <tr>

                                <td>
                                    @sale.Id
                                </td>


                                <td>

                                    <strong class="invoice-number">
                                        @sale.InvoiceNumber
                                    </strong>

                                </td>


                                <td>

                                    @sale.SaleDate.ToString(
                                        "dd/MM/yyyy hh:mm tt")

                                </td>


                                <td>

                                    <span class="medicine-count">

                                        @sale.Items.Sum(
                                            item =>
                                                item.Quantity)

                                    </span>

                                    item(s)

                                </td>


                                <!-- ORIGINAL GROSS -->

                                <td>
                                    Rs.
                                    @sale.TotalAmount.ToString("N2")
                                </td>


                                <!-- DISCOUNT -->

                                <td>

                                    @if (sale.DiscountAmount > 0)
                                    {
                                        <span>
                                            -
                                            Rs.
                                            @sale.DiscountAmount.ToString("N2")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="no-refund">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- ORIGINAL NET -->

                                <td>
                                    Rs.
                                    @sale.NetAmount.ToString("N2")
                                </td>


                                <!-- REFUND -->

                                <td>

                                    @if (saleRefund > 0)
                                    {
                                        <span class="refund-text">

                                            - Rs.
                                            @saleRefund.ToString("N2")

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="no-refund">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- ACTUAL GROSS -->

                                <td>

                                    <strong>
                                        Rs.
                                        @actualGross.ToString("N2")
                                    </strong>

                                </td>


                                <!-- ACTUAL NET -->

                                <td>

                                    <strong>
                                        Rs.
                                        @actualNet.ToString("N2")
                                    </strong>

                                </td>


                                <!-- RECEIVED -->

                                <td>
                                    Rs.
                                    @sale.AmountReceived.ToString("N2")
                                </td>


                                <!-- CHANGE -->

                                <td>
                                    Rs.
                                    @sale.ChangeAmount.ToString("N2")
                                </td>


                                <!-- ACTION -->

                                <td>

                                    <div class="action-buttons">

                                        <a asp-action="Bill"
                                           asp-route-id="@sale.Id"
                                           class="table-btn bill-btn">

                                            Bill

                                        </a>


                                        <a asp-controller="Return"
                                           asp-action="Create"
                                           asp-route-saleId="@sale.Id"
                                           class="table-btn return-btn">

                                            Return

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


@section Scripts
{
    <script>

        function searchSales()
        {
            const search =
                document
                    .getElementById("salesSearch")
                    .value
                    .toLowerCase()
                    .trim();


            const rows =
                document.querySelectorAll(
                    "#salesTableBody tr");


            rows.forEach(function(row)
            {
                const text =
                    row.textContent.toLowerCase();


                row.style.display =
                    text.includes(search)
                        ? ""
                        : "none";
            });
        }

    </script>
}


<style>

    /* ============================================================
       PAGE
    ============================================================ */

    .sales-page
    {
        width: 100%;
        max-width: none;
        margin: 0;
        box-sizing: border-box;
    }
    .sales-page
    {
        width: 100%;
        max-width: none;
        margin: 0;
        padding: 0 4px;
        box-sizing: border-box;
    }


    /* ============================================================
       HEADER
    ============================================================ */

    .page-header
    {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        width: 100%;
        margin-bottom: 22px;
    }


    .page-header h1
