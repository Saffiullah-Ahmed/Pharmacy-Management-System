        color: #2563eb;
    }


    .bill-btn:hover
    {
        background: #dbeafe;
    }


    .return-btn
    {
        background: #fff7ed;
        color: #ea580c;
    }


    .return-btn:hover
    {
        background: #ffedd5;
    }


    /* ============================================================
       EMPTY
    ============================================================ */

    .empty-row
    {
        text-align: center;
        padding: 40px !important;
        color: #94a3b8 !important;
    }


    /* ============================================================
       RESPONSIVE
    ============================================================ */

    @@media (max-width: 1200px)
    {
        .summary-grid
        {
            grid-template-columns:
                repeat(3, 1fr);
        }

        .today-grid
        {
            grid-template-columns:
                repeat(2, 1fr);
        }
    }


    @@media (max-width: 700px)
    {
        .page-header
        {
            flex-direction: column;
            align-items: flex-start;
        }


        .today-header
