    }


    .sales-table td
    {
        padding: 14px 15px;
        color: #475569;
        font-size: 12px;
        border-bottom:
            1px solid #f1f5f9;
        white-space: nowrap;
    }


    .sales-table tbody tr:hover
    {
        background: #f8fafc;
    }


    .invoice-number
    {
        color: #2563eb;
    }


    .medicine-count
    {
        font-weight: 700;
        color: #172554;
    }


    .refund-text
    {
        color: #dc2626;
        font-weight: 600;
    }


    .no-refund
