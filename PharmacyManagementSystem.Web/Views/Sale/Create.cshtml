@model PharmacyManagementSystem.Web.Models.Sale

@using PharmacyManagementSystem.Web.Models

@{
    ViewData["Title"] = "Create Sale";

    var customers =
        ViewBag.Customers as List<Customer>
        ?? new List<Customer>();

    var selectedMedicines =
        ViewBag.SelectedMedicines as List<Medicine>
        ?? new List<Medicine>();

    var selectedMedicineLookup =
        selectedMedicines
            .ToDictionary(
                x => x.Id,
                x => x);
}


<div class="sale-page">

    <!-- ==========================================================
         HEADER
    ========================================================== -->

    <div class="sale-header">

        <div>

            <h1>
                Create Sale
            </h1>

            <p>
                Create a new medicine sale
            </p>

        </div>


        <a asp-action="Index"
           class="back-btn">

            ← Back to Sales

        </a>

    </div>


    <!-- ==========================================================
         VALIDATION SUMMARY
    ========================================================== -->

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All"
             class="validation-summary">
        </div>
    }


    <!-- ==========================================================
         SALE FORM
    ========================================================== -->

    <form asp-action="Create"
          method="post"
          id="saleForm">

        @Html.AntiForgeryToken()


        <!-- ======================================================
             CUSTOMER
        ====================================================== -->

        <div class="sale-card">

            <div class="card-title">

                <div>

                    <h2>
                        Customer
                    </h2>

                    <p>
                        Select a customer or leave blank for walk-in sales.
                    </p>

                </div>

            </div>


            <div class="form-group">

                <label asp-for="CustomerId">
                    Customer
                </label>


                <select asp-for="CustomerId"
                        class="form-control">

                    <option value="">
                        -- Walk-in Customer --
                    </option>


                    @foreach (var customer in customers)
                    {
                        <option value="@customer.Id">

                            @customer.Name

                            @if (!string.IsNullOrWhiteSpace(
                                customer.Phone))
                            {
                                <text>
                                    | @customer.Phone
                                </text>
                            }

                        </option>
                    }

                </select>


                <small>
                    A customer is required if the customer leaves an outstanding balance.
                </small>

            </div>

        </div>


        <!-- ======================================================
             MEDICINES
        ====================================================== -->

        <div class="sale-card">

            <div class="card-title">

                <div>

                    <h2>
                        Medicines
                    </h2>

                    <p>
                        Search for a medicine by name or medicine ID.
                    </p>

                </div>


                <button type="button"
                        class="add-btn"
                        id="addMedicineBtn">

                    + Add Medicine

                </button>

            </div>


            <!-- ==================================================
                 SEARCH INFORMATION
            ================================================== -->

            <div class="medicine-search-info">

                <span class="search-info-icon">
                    🔍
                </span>

                <span>
                    Type at least 2 characters to search medicines.
                    Only matching medicines are loaded from the server.
                </span>

            </div>


            <!-- ==================================================
                 MEDICINE ROWS
            ================================================== -->

            <div id="medicineRows">


                @{
                    var initialItems =
                        Model.Items != null &&
                        Model.Items.Count > 0
                            ? Model.Items
                            : new List<SaleItem>
                            {
                                new SaleItem()
                            };
                }


                @for (
                    int i = 0;
                    i < initialItems.Count;
                    i++)
                {
                    var item =
                        initialItems[i];

                    Medicine? selectedMedicine = null;


                    if (item.MedicineId.HasValue)
                    {
                        selectedMedicineLookup.TryGetValue(
                            item.MedicineId.Value,
                            out selectedMedicine);
                    }


                    <div class="medicine-row">


                        <!-- ======================================
                             MEDICINE SEARCH
                        ======================================= -->

                        <div class="form-group medicine-field">

                            <label>
                                Medicine
                            </label>


                            <div class="medicine-search-wrapper">


                                <!-- VISIBLE SEARCH INPUT -->

                                <input type="text"
                                       class="form-control medicine-search-input"
                                       placeholder="Search medicine name or ID..."
                                       autocomplete="off"
                                       value="@(selectedMedicine?.Name ?? item.MedicineName)"
                                       data-selected-id="@(item.MedicineId?.ToString() ?? "")" />


                                <!-- ACTUAL VALUE SUBMITTED -->

                                <input type="hidden"
                                       name="Items[@i].MedicineId"
                                       class="medicine-id-input"
                                       value="@(item.MedicineId?.ToString() ?? "")" />


                                <!-- SEARCH RESULTS -->

                                <div class="medicine-results">
                                </div>


                            </div>


                            <!-- SELECTED MEDICINE INFORMATION -->

                            <div class="selected-medicine-info">

                                @if (selectedMedicine != null)
                                {
                                    <span>
                                        Stock:
                                        <strong>
                                            @selectedMedicine.Quantity
                                        </strong>
                                    </span>

                                    <span>
                                        Price:
                                        <strong>
                                            Rs.
                                            @selectedMedicine.Price.ToString("N2")
                                        </strong>
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        Search and select a medicine.
                                    </span>
                                }

                            </div>

                        </div>


                        <!-- ======================================
                             QUANTITY
                        ======================================= -->

                        <div class="form-group quantity-field">

                            <label>
                                Quantity
                            </label>


                            <input type="number"
                                   name="Items[@i].Quantity"
                                   class="form-control quantity-input"
                                   min="1"
                                   placeholder="Enter quantity"
                                   value="@(item.Quantity?.ToString() ?? "")"
                                   required />

                        </div>


                        <!-- ======================================
                             UNIT PRICE
                        ======================================= -->

                        <div class="form-group price-field">

                            <label>
                                Unit Price
                            </label>


                            <input type="text"
                                   class="form-control price-display"
                                   value="@(selectedMedicine != null
                                       ? "Rs. " + selectedMedicine.Price.ToString("N2")
                                       : "Rs. 0.00")"
                                   readonly />

                        </div>


                        <!-- ======================================
                             TOTAL
                        ======================================= -->

                        <div class="form-group total-field">

                            <label>
                                Total
                            </label>


                            <input type="text"
                                   class="form-control item-total-display"
                                   value="Rs. 0.00"
                                   readonly />

                        </div>


                        <!-- ======================================
                             REMOVE
                        ======================================= -->

                        <button type="button"
                                class="remove-btn"
                                onclick="removeMedicine(this)">

                            ×

                        </button>

                    </div>
                }

            </div>

        </div>


        <!-- ======================================================
             PAYMENT
        ====================================================== -->

        <div class="sale-card">

            <div class="card-title">

                <div>

                    <h2>
                        Payment
                    </h2>

                    <p>
                        Review the sale total and payment information.
                    </p>

                </div>

            </div>


            <div class="payment-grid">


                <!-- ==================================================
                     TOTAL AMOUNT
                ================================================== -->

                <div class="summary-box">

                    <span>
                        Total Amount
                    </span>

                    <strong id="totalAmountDisplay">
                        Rs. 0.00
                    </strong>

                </div>


                <!-- ==================================================
                     DISCOUNT
                ================================================== -->

                <div class="form-group">

                    <label>
                        Discount
                    </label>


                    <input type="text"
                           id="discountInput"
                           class="form-control"
                           inputmode="decimal"
                           autocomplete="off"
                           placeholder="0.00" />


                    <input type="hidden"
                           asp-for="DiscountAmount"
                           id="discountAmount" />

                </div>


                <!-- ==================================================
                     NET AMOUNT
                ================================================== -->

                <div class="summary-box">

                    <span>
                        Net Amount
                    </span>

                    <strong id="netAmountDisplay">
                        Rs. 0.00
                    </strong>

                </div>


                <!-- ==================================================
                     AMOUNT RECEIVED
                ================================================== -->

                <div class="form-group">

                    <label>
                        Amount Received
                    </label>


                    <input type="text"
                           id="amountReceivedInput"
                           class="form-control"
                           inputmode="decimal"
                           autocomplete="off"
                           placeholder="0.00" />


                    <input type="hidden"
                           asp-for="AmountReceived"
                           id="amountReceived" />

                </div>


                <!-- ==================================================
                     CHANGE
                ================================================== -->

                <div class="summary-box">

                    <span>
                        Change
                    </span>

                    <strong id="changeDisplay">
                        Rs. 0.00
                    </strong>

                </div>


                <!-- ==================================================
                     BALANCE
                ================================================== -->

                <div class="summary-box balance-box">

                    <span>
                        Balance
                    </span>

                    <strong id="balanceDisplay">
                        Rs. 0.00
                    </strong>

                </div>

            </div>


            <!-- ======================================================
                 HIDDEN VALUES
            ====================================================== -->

            <input type="hidden"
                   asp-for="TotalAmount"
                   id="totalAmount" />


            <input type="hidden"
                   asp-for="NetAmount"
                   id="netAmount" />


            <input type="hidden"
                   asp-for="ChangeAmount"
                   id="changeAmount" />


            <input type="hidden"
                   asp-for="BalanceAmount"
                   id="balanceAmount" />


            <input type="hidden"
                   asp-for="GenerateBill" />

        </div>


        <!-- ======================================================
             ACTIONS
        ====================================================== -->

        <div class="form-actions">

            <a asp-action="Index"
               class="cancel-btn">

                Cancel

            </a>


            <button type="submit"
                    class="complete-btn"
                    id="completeSaleBtn">

                ✓ Complete Sale

            </button>

        </div>

    </form>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />


    <script>

        // ==========================================================
        // MEDICINE INDEX
        // ==========================================================

        let medicineIndex =
            document.querySelectorAll(
                ".medicine-row"
            ).length;


        // ==========================================================
        // SEARCH TIMER
        // ==========================================================

        const medicineSearchTimers =
            new WeakMap();


        // ==========================================================
        // SEARCH URL
        // ==========================================================

        const medicineSearchUrl =
            "@Url.Action("SearchMedicines", "Sale")";


        // ==========================================================
        // FORMAT CURRENCY
        // ==========================================================

        function formatCurrency(value)
        {
            return "Rs. " +
                Number(value || 0).toFixed(2);
        }


        // ==========================================================
        // GET MEDICINE DATA FROM ROW
        // ==========================================================

        function getSelectedMedicineData(row)
        {
            if (!row)
            {
                return null;
            }

            const searchInput =
                row.querySelector(
                    ".medicine-search-input"
                );

            const medicineIdInput =
                row.querySelector(
                    ".medicine-id-input"
                );

            if (!medicineIdInput ||
                !medicineIdInput.value)
            {
                return null;
            }

            return {
                id:
                    medicineIdInput.value,

                name:
                    searchInput
                        ? searchInput.value
                        : "",

                price:
                    parseFloat(
                        row.getAttribute(
                            "data-price"
                        )
                    ) || 0,

                quantity:
                    parseInt(
                        row.getAttribute(
                            "data-stock"
                        )
                    ) || 0
            };
        }


        // ==========================================================
        // SET MEDICINE INFORMATION
        // ==========================================================

        function setMedicine(
            row,
            medicine)
        {
            const searchInput =
                row.querySelector(
                    ".medicine-search-input"
                );

            const medicineIdInput =
                row.querySelector(
                    ".medicine-id-input"
                );

            const priceDisplay =
                row.querySelector(
                    ".price-display"
                );

            const info =
                row.querySelector(
                    ".selected-medicine-info"
                );


            medicineIdInput.value =
                medicine.id;


            searchInput.value =
                medicine.name;


            searchInput.dataset.selectedId =
                medicine.id;


            row.setAttribute(
                "data-price",
                medicine.price
            );


            row.setAttribute(
                "data-stock",
                medicine.quantity
            );


            priceDisplay.value =
                formatCurrency(
                    medicine.price
                );


            if (info)
            {
                info.innerHTML = `
                    <span>
                        Stock:
                        <strong>
                            ${medicine.quantity}
                        </strong>
                    </span>

                    <span>
                        Price:
                        <strong>
                            ${formatCurrency(medicine.price)}
                        </strong>
                    </span>
                `;
            }


            hideMedicineResults(row);


            updateMedicineRow(row);

            calculateTotal();
        }


        // ==========================================================
        // CLEAR MEDICINE
        // ==========================================================

        function clearMedicine(row)
        {
            const searchInput =
                row.querySelector(
                    ".medicine-search-input"
                );

            const medicineIdInput =
                row.querySelector(
                    ".medicine-id-input"
                );

            const priceDisplay =
                row.querySelector(
                    ".price-display"
                );

            const info =
                row.querySelector(
                    ".selected-medicine-info"
                );


            medicineIdInput.value =
                "";


            searchInput.dataset.selectedId =
                "";


            row.removeAttribute(
                "data-price"
            );


            row.removeAttribute(
                "data-stock"
            );


            priceDisplay.value =
                "Rs. 0.00";


            if (info)
            {
                info.innerHTML =
                    `<span>
                        Search and select a medicine.
                    </span>`;
            }


            updateMedicineRow(row);

            calculateTotal();
        }


        // ==========================================================
        // HIDE SEARCH RESULTS
        // ==========================================================

        function hideMedicineResults(row)
        {
            const results =
                row.querySelector(
                    ".medicine-results"
                );

            if (results)
            {
                results.innerHTML = "";
                results.classList.remove(
                    "show"
                );
            }
        }


        // ==========================================================
        // SEARCH MEDICINES
        // ==========================================================

        function searchMedicines(
            input)
        {
            const row =
                input.closest(
                    ".medicine-row"
                );

            if (!row)
            {
                return;
            }


            const query =
                input.value.trim();


            const results =
                row.querySelector(
                    ".medicine-results"
                );


            // ------------------------------------------------------
            // Clear selected ID when user changes search text.
            // ------------------------------------------------------

            const selectedId =
                input.dataset.selectedId || "";


            if (
                selectedId &&
                input.value.trim() !==
                input.getAttribute(
                    "data-selected-name"
                )
            )
            {
                const hiddenId =
                    row.querySelector(
                        ".medicine-id-input"
                    );

                if (hiddenId)
                {
                    hiddenId.value = "";
                }

                input.dataset.selectedId = "";

                row.removeAttribute(
                    "data-price"
                );

                row.removeAttribute(
                    "data-stock"
                );

                const priceDisplay =
                    row.querySelector(
                        ".price-display"
                    );

                if (priceDisplay)
                {
                    priceDisplay.value =
                        "Rs. 0.00";
                }
            }


            if (query.length < 2)
            {
                hideMedicineResults(row);

                return;
            }


            if (medicineSearchTimers.has(input))
            {
                clearTimeout(
                    medicineSearchTimers.get(
                        input
                    )
                );
            }


            const timer =
                setTimeout(
                    async function()
                    {
                        results.innerHTML =
                            `<div class="medicine-result-loading">
                                Searching...
                            </div>`;

                        results.classList.add(
                            "show"
                        );


                        try
                        {
                            const response =
                                await fetch(
                                    medicineSearchUrl +
                                    "?q=" +
                                    encodeURIComponent(
                                        query
                                    ),
                                    {
                                        headers:
                                        {
                                            "X-Requested-With":
                                                "XMLHttpRequest"
                                        }
                                    }
                                );


                            if (!response.ok)
                            {
                                throw new Error(
                                    "Search failed."
                                );
                            }


                            const medicines =
                                await response.json();


                            // Make sure this response still
                            // belongs to the current search.

                            if (
                                input.value
                                    .trim()
                                    .toLowerCase()
                                !== query.toLowerCase()
                            )
                            {
                                return;
                            }


                            results.innerHTML = "";


                            if (
                                !medicines ||
                                medicines.length === 0
                            )
                            {
                                results.innerHTML =
                                    `<div class="medicine-result-empty">
                                        No medicines found.
                                    </div>`;

                                results.classList.add(
                                    "show"
                                );

                                return;
                            }


                            medicines.forEach(
                                function(medicine)
                                {
                                    const button =
                                        document.createElement(
                                            "button"
                                        );

                                    button.type =
                                        "button";

                                    button.className =
                                        "medicine-result";


                                    const stockClass =
                                        medicine.quantity <= 0
                                            ? "out-of-stock"
                                            : "";


                                    button.innerHTML = `
                                        <span class="medicine-result-main">

                                            <strong>
                                                ${escapeHtml(
                                                    medicine.name
                                                )}
                                            </strong>

                                            <small>
                                                ID:
                                                ${medicine.id}
                                            </small>

                                        </span>

                                        <span class="medicine-result-details">

                                            <span>
                                                Stock:
                                                <b class="${stockClass}">
                                                    ${medicine.quantity}
                                                </b>
                                            </span>

                                            <span>
                                                Rs.
                                                ${Number(
                                                    medicine.price
                                                ).toFixed(2)}
                                            </span>

                                        </span>
                                    `;


                                    button.addEventListener(
                                        "click",
                                        function()
                                        {
                                            input.setAttribute(
                                                "data-selected-name",
                                                medicine.name
                                            );

                                            setMedicine(
                                                row,
                                                medicine
                                            );
                                        }
                                    );


                                    results.appendChild(
                                        button
                                    );
                                }
                            );


                            results.classList.add(
                                "show"
                            );
                        }
                        catch (error)
                        {
                            results.innerHTML =
                                `<div class="medicine-result-empty">
                                    Unable to search medicines.
                                    Please try again.
                                </div>`;

                            results.classList.add(
                                "show"
                            );
                        }

                    },
                    250
                );


            medicineSearchTimers.set(
                input,
                timer
            );
        }


        // ==========================================================
        // ESCAPE HTML
        // ==========================================================

        function escapeHtml(value)
        {
            return String(value ?? "")
                .replace(
                    /&/g,
                    "&amp;"
                )
                .replace(
                    /</g,
                    "&lt;"
                )
                .replace(
                    />/g,
                    "&gt;"
                )
                .replace(
                    /"/g,
                    "&quot;"
                )
                .replace(
                    /'/g,
                    "&#039;"
                );
        }


        // ==========================================================
        // UPDATE MEDICINE ROW
        // ==========================================================

        function updateMedicineRow(row)
        {
            if (!row)
            {
                return;
            }


            const quantityInput =
                row.querySelector(
                    ".quantity-input"
                );


            const totalDisplay =
                row.querySelector(
                    ".item-total-display"
                );


            const price =
                parseFloat(
                    row.getAttribute(
                        "data-price"
                    )
                ) || 0;


            const quantity =
                parseInt(
                    quantityInput.value
                ) || 0;


            totalDisplay.value =
                formatCurrency(
                    price * quantity
                );
        }


        // ==========================================================
        // GET DISCOUNT
        // ==========================================================

        function getDiscount()
        {
            const input =
                document.getElementById(
                    "discountInput"
                );


            const value =
                parseFloat(
                    input.value
                );


            if (isNaN(value))
            {
                return 0;
            }


            if (value < 0)
            {
                return 0;
            }


            return value;
        }


        // ==========================================================
        // GET AMOUNT RECEIVED
        // ==========================================================

        function getAmountReceived()
        {
            const input =
                document.getElementById(
                    "amountReceivedInput"
                );


            const value =
                parseFloat(
                    input.value
                );


            if (isNaN(value))
            {
                return 0;
            }


            if (value < 0)
            {
                return 0;
            }


            return value;
        }


        // ==========================================================
        // CALCULATE TOTAL
        // ==========================================================

        function calculateTotal()
        {
            let total = 0;


            document
                .querySelectorAll(
                    ".medicine-row"
                )
                .forEach(
                    function(row)
                    {
                        const price =
                            parseFloat(
                                row.getAttribute(
                                    "data-price"
                                )
                            ) || 0;


                        const quantityInput =
                            row.querySelector(
                                ".quantity-input"
                            );


                        const quantity =
                            parseInt(
                                quantityInput.value
                            ) || 0;


                        const itemTotal =
                            price * quantity;


                        const totalDisplay =
                            row.querySelector(
                                ".item-total-display"
                            );


                        totalDisplay.value =
                            formatCurrency(
                                itemTotal
                            );


                        total +=
                            itemTotal;
                    }
                );


            document.getElementById(
                "totalAmountDisplay"
            ).textContent =
                formatCurrency(total);


            document.getElementById(
                "totalAmount"
            ).value =
                total.toFixed(2);


            calculatePayment(
                total
            );
        }


        // ==========================================================
        // CALCULATE PAYMENT
        // ==========================================================

        function calculatePayment(total)
        {
            let discount =
                getDiscount();


            let amountReceived =
                getAmountReceived();


            if (discount > total)
            {
                discount = total;
            }


            const net =
                total - discount;


            let change = 0;

            let balance = 0;


            if (amountReceived >= net)
            {
                change =
                    amountReceived - net;
            }
            else
            {
                balance =
                    net - amountReceived;
            }


            document.getElementById(
                "netAmountDisplay"
            ).textContent =
                formatCurrency(net);


            document.getElementById(
                "changeDisplay"
            ).textContent =
                formatCurrency(change);


            document.getElementById(
                "balanceDisplay"
            ).textContent =
                formatCurrency(balance);


            document.getElementById(
                "discountAmount"
            ).value =
                discount.toFixed(2);


            document.getElementById(
                "amountReceived"
            ).value =
                amountReceived.toFixed(2);


            document.getElementById(
                "netAmount"
            ).value =
                net.toFixed(2);


            document.getElementById(
                "changeAmount"
            ).value =
                change.toFixed(2);


            document.getElementById(
                "balanceAmount"
            ).value =
                balance.toFixed(2);
        }


        // ==========================================================
        // ADD MEDICINE
        // ==========================================================

        document
            .getElementById(
                "addMedicineBtn"
            )
            .addEventListener(
                "click",
                function()
                {
                    const container =
                        document.getElementById(
                            "medicineRows"
                        );


                    const row =
                        document.createElement(
                            "div"
                        );


                    row.className =
                        "medicine-row";


                    row.innerHTML = `
                        <div class="form-group medicine-field">

                            <label>
                                Medicine
                            </label>

                            <div class="medicine-search-wrapper">

                                <input
                                    type="text"
                                    class="form-control medicine-search-input"
                                    placeholder="Search medicine name or ID..."
                                    autocomplete="off"
                                    value=""
                                />

                                <input
                                    type="hidden"
                                    name="Items[${medicineIndex}].MedicineId"
                                    class="medicine-id-input"
                                    value=""
                                />

                                <div class="medicine-results">
                                </div>

                            </div>

                            <div class="selected-medicine-info">

                                <span>
                                    Search and select a medicine.
                                </span>

                            </div>

                        </div>


                        <div class="form-group quantity-field">

                            <label>
                                Quantity
                            </label>

                            <input
                                type="number"
                                name="Items[${medicineIndex}].Quantity"
                                class="form-control quantity-input"
                                min="1"
                                placeholder="Enter quantity"
                                required
                            />

                        </div>


                        <div class="form-group price-field">

                            <label>
                                Unit Price
                            </label>

                            <input
                                type="text"
                                class="form-control price-display"
                                value="Rs. 0.00"
                                readonly
                            />

                        </div>


                        <div class="form-group total-field">

                            <label>
                                Total
                            </label>

                            <input
                                type="text"
                                class="form-control item-total-display"
                                value="Rs. 0.00"
                                readonly
                            />

                        </div>


                        <button
                            type="button"
                            class="remove-btn"
                            onclick="removeMedicine(this)">

                            ×

                        </button>
                    `;


                    container.appendChild(
                        row
                    );


                    medicineIndex++;
                }
            );


        // ==========================================================
        // REMOVE MEDICINE
        // ==========================================================

        function removeMedicine(button)
        {
            const rows =
                document.querySelectorAll(
                    ".medicine-row"
                );


            if (rows.length <= 1)
            {
                alert(
                    "At least one medicine is required."
                );

                return;
            }


            button
                .closest(
                    ".medicine-row"
                )
                .remove();


            reindexItems();

            calculateTotal();
        }


        // ==========================================================
        // REINDEX MEDICINE ITEMS
        // ==========================================================

        function reindexItems()
        {
            const rows =
                document.querySelectorAll(
                    ".medicine-row"
                );


            rows.forEach(
                function(row, index)
                {
                    const medicineIdInput =
                        row.querySelector(
                            ".medicine-id-input"
                        );


                    const quantityInput =
                        row.querySelector(
                            ".quantity-input"
                        );


                    medicineIdInput.name =
                        `Items[${index}].MedicineId`;


                    quantityInput.name =
                        `Items[${index}].Quantity`;
                }
            );


            medicineIndex =
                rows.length;
        }


        // ==========================================================
        // MEDICINE SEARCH INPUT
        // ==========================================================

        document.addEventListener(
            "input",
            function(event)
            {
                if (
                    event.target.classList.contains(
                        "medicine-search-input"
                    )
                )
                {
                    searchMedicines(
                        event.target
                    );
                }


                if (
                    event.target.classList.contains(
                        "quantity-input"
                    )
                )
                {
                    const row =
                        event.target.closest(
                            ".medicine-row"
                        );


                    updateMedicineRow(
                        row
                    );


                    calculateTotal();
                }
            }
        );


        // ==========================================================
        // DISCOUNT INPUT
        // ==========================================================

        document
            .getElementById(
                "discountInput"
            )
            .addEventListener(
                "input",
                function()
                {
                    const total =
                        parseFloat(
                            document.getElementById(
                                "totalAmount"
                            ).value
                        ) || 0;


                    calculatePayment(
                        total
                    );
                }
            );


        // ==========================================================
        // AMOUNT RECEIVED INPUT
        // ==========================================================

        document
            .getElementById(
                "amountReceivedInput"
            )
            .addEventListener(
                "input",
                function()
                {
                    const total =
                        parseFloat(
                            document.getElementById(
                                "totalAmount"
                            ).value
                        ) || 0;


                    calculatePayment(
                        total
                    );
                }
            );


        // ==========================================================
        // CLOSE SEARCH RESULTS WHEN CLICKING OUTSIDE
        // ==========================================================

        document.addEventListener(
            "click",
            function(event)
            {
                if (
                    !event.target.closest(
                        ".medicine-search-wrapper"
                    )
                )
                {
                    document
                        .querySelectorAll(
                            ".medicine-results"
                        )
                        .forEach(
                            function(results)
                            {
                                results.classList.remove(
                                    "show"
                                );
                            }
                        );
                }
            }
        );


        // ==========================================================
        // FORM SUBMIT
        // ==========================================================

        document
            .getElementById(
                "saleForm"
            )
            .addEventListener(
                "submit",
                function(event)
                {
                    reindexItems();

                    calculateTotal();


                    const rows =
                        document.querySelectorAll(
                            ".medicine-row"
                        );


                    if (rows.length === 0)
                    {
                        event.preventDefault();

                        alert(
                            "Please add at least one medicine."
                        );

                        return;
                    }


                    let valid = true;


                    rows.forEach(
                        function(row)
                        {
                            const medicineId =
                                row.querySelector(
                                    ".medicine-id-input"
                                );


                            const quantityInput =
                                row.querySelector(
                                    ".quantity-input"
                                );


                            if (
                                !medicineId.value
                            )
                            {
                                valid = false;
                            }


                            const quantity =
                                parseInt(
                                    quantityInput.value
                                ) || 0;


                            if (
                                quantity <= 0
                            )
                            {
                                valid = false;
                            }
                        }
                    );


                    if (!valid)
                    {
                        event.preventDefault();

                        alert(
                            "Please search and select a medicine and enter a valid quantity for every medicine."
                        );

                        return;
                    }


                    const balance =
                        parseFloat(
                            document.getElementById(
                                "balanceAmount"
                            ).value
                        ) || 0;


                    const customer =
                        document.getElementById(
                            "CustomerId"
                        );


                    if (
                        balance > 0 &&
                        !customer.value
                    )
                    {
                        event.preventDefault();

                        alert(
                            "Please select a customer when there is an outstanding balance."
                        );

                        customer.focus();

                        return;
                    }


                    const total =
                        parseFloat(
                            document.getElementById(
                                "totalAmount"
                            ).value
                        ) || 0;


                    calculatePayment(
                        total
                    );
                }
            );


        // ==========================================================
        // INITIALIZE SELECTED MEDICINES
        // ==========================================================

        document.addEventListener(
            "DOMContentLoaded",
            function()
            {
                document
                    .querySelectorAll(
                        ".medicine-row"
                    )
                    .forEach(
                        function(row)
                        {
                            const searchInput =
                                row.querySelector(
                                    ".medicine-search-input"
                                );


                            const medicineIdInput =
                                row.querySelector(
                                    ".medicine-id-input"
                                );


                            if (
                                medicineIdInput &&
                                medicineIdInput.value
                            )
                            {
                                const info =
                                    row.querySelector(
                                        ".selected-medicine-info"
                                    );


                                const priceDisplay =
                                    row.querySelector(
                                        ".price-display"
                                    );


                                if (
                                    priceDisplay &&
                                    priceDisplay.value !==
                                    "Rs. 0.00"
                                )
                                {
                                    const priceText =
                                        priceDisplay.value
                                            .replace(
                                                "Rs.",
                                                ""
                                            )
                                            .trim();


                                    const price =
                                        parseFloat(
                                            priceText
                                        ) || 0;


                                    row.setAttribute(
                                        "data-price",
                                        price
                                    );


                                    if (searchInput)
                                    {
                                        searchInput.setAttribute(
                                            "data-selected-name",
                                            searchInput.value
                                        );

                                        searchInput.dataset.selectedId =
                                            medicineIdInput.value;
                                    }


                                    if (info)
                                    {
                                        // Existing Razor-rendered
                                        // information is retained.
                                    }
                                }
                            }


                            updateMedicineRow(
                                row
                            );
                        }
                    );


                calculateTotal();
            }
        );

    </script>
}


