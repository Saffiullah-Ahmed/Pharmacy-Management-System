@model List<PharmacyManagementSystem.Web.Models.Customer>

@{
    ViewData["Title"] = "Pending Payments";

    int pharmacyId =
        ViewBag.PharmacyId is int id
            ? id
            : 0;

    string search =
        ViewBag.Search as string
        ?? string.Empty;
}


<div class="credit-page">

    <!-- ============================================================
         HEADER
    ============================================================ -->

    <div class="credit-header">

        <div>

            <h1>
                Pending Payments
            </h1>

            <p>
                Customers who currently have outstanding balances
            </p>

        </div>


        <a asp-controller="Sale"
           asp-action="Index"
           class="back-btn">

            ← Back to Sales

        </a>

    </div>


    <!-- ============================================================
         MESSAGES
    ============================================================ -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-message">

            ✓ @TempData["SuccessMessage"]

        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="error-message">

            ⚠ @TempData["ErrorMessage"]

        </div>
    }


    <!-- ============================================================
         SEARCH
    ============================================================ -->

    <div class="search-card">

        <form asp-controller="CustomerCredit"
              asp-action="Index"
              method="get"
              class="search-form">

            <div class="search-input-wrapper">

                <span class="search-icon">
                    🔍
                </span>


                <input type="text"
                       name="search"
                       value="@search"
                       class="search-input"
                       placeholder="Search by customer name or invoice number..."
                       autocomplete="off" />

            </div>


            <button type="submit"
                    class="search-btn">

                Search

            </button>


            @if (!string.IsNullOrWhiteSpace(search))
            {
                <a asp-controller="CustomerCredit"
                   asp-action="Index"
                   class="clear-btn">

                    Clear

                </a>
            }

        </form>


        <div class="search-help">

            You can search using the customer's name or invoice number.

        </div>

    </div>


    <!-- ============================================================
         CUSTOMER LIST
    ============================================================ -->

    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-card">

            <div class="empty-icon">

                @if (!string.IsNullOrWhiteSpace(search))
                {
                    <span>🔍</span>
                }
                else
                {
                    <span>✓</span>
                }

            </div>


            @if (!string.IsNullOrWhiteSpace(search))
            {
                <h2>
                    No Results Found
                </h2>

                <p>
                    No pending payment was found for
                    "<strong>@search</strong>".
                </p>


                <a asp-controller="CustomerCredit"
                   asp-action="Index"
                   class="clear-results-btn">

                    Show All Pending Payments

                </a>
            }
            else
            {
                <h2>
                    No Pending Payments
                </h2>

                <p>
                    All customer accounts are currently settled.
                </p>
            }

        </div>
    }
    else
    {
        <div class="results-info">

            <span>

                Showing

                <strong>
                    @Model.Count
                </strong>

                customer@(Model.Count == 1 ? "" : "s")

            </span>


            @if (!string.IsNullOrWhiteSpace(search))
            {
                <span>

                    Search:

                    <strong>
                        "@search"
                    </strong>

                </span>
            }

        </div>


        <div class="customer-list">

            @foreach (var customer in Model)
            {
                decimal balance =
                    PharmacyManagementSystem.Web.DataStorage
                        .CustomerCreditStorage
                        .GetCustomerBalance(
                            customer.Id,
                            pharmacyId);


                <div class="customer-card">

                    <div class="customer-main">

                        <div class="customer-icon">

                            👤

                        </div>


                        <div>

                            <h2>
                                @customer.Name
                            </h2>

                            <p>
                                📞 @customer.Phone
                            </p>

                        </div>

                    </div>


                    <div class="customer-balance">

                        <span>
                            Outstanding Balance
                        </span>

                        <strong>
                            Rs. @balance.ToString("N2")
                        </strong>

                    </div>


                    <div class="customer-action">

                        <a asp-controller="CustomerCredit"
                           asp-action="Details"
                           asp-route-id="@customer.Id"
                           class="view-btn">

                            View Details →

                        </a>

                    </div>

                </div>
            }

        </div>
    }

</div>


<style>

    /* ============================================================
       PAGE
    ============================================================ */

    .credit-page
    {
        width: 100%;
        max-width: none;
        margin: 0;
        padding: 0 4px;
        box-sizing: border-box;
    }


    /* ============================================================
       HEADER
    ============================================================ */

    .credit-header
    {
        display: flex;

        justify-content: space-between;

        align-items: center;

        gap: 20px;

        margin-bottom: 22px;
    }


    .credit-header h1
    {
        margin: 0;

        color: #172554;

        font-size: 30px;

        font-weight: 700;
    }


    .credit-header p
    {
        margin: 5px 0 0;

        color: #64748b;

        font-size: 14px;
    }


    /* ============================================================
       BACK BUTTON
    ============================================================ */

    .back-btn
    {
        display: inline-flex;

        align-items: center;

        justify-content: center;

        padding: 10px 15px;

        background: white;

        color: #475569;

        border: 1px solid #e2e8f0;

        border-radius: 9px;

        text-decoration: none;

        font-size: 13px;

        font-weight: 600;

        white-space: nowrap;
    }


    .back-btn:hover
    {
        background: #f8fafc;

        color: #172554;
    }


    /* ============================================================
       SEARCH
    ============================================================ */

    .search-card
    {
        width: 100%;

        box-sizing: border-box;

        background: white;

        border: 1px solid #e2e8f0;

        border-radius: 14px;

        padding: 18px;

        margin-bottom: 18px;

        box-shadow:
            0 4px 14px
            rgba(15,23,42,.04);
    }


    .search-form
    {
        display: flex;

        align-items: center;

        gap: 10px;
    }


    .search-input-wrapper
    {
        position: relative;

        flex: 1;
    }


    .search-icon
    {
        position: absolute;

        left: 13px;

        top: 50%;

        transform: translateY(-50%);

        font-size: 14px;
    }


    .search-input
    {
        width: 100%;

        box-sizing: border-box;

        padding: 12px 13px 12px 38px;

        border: 1px solid #cbd5e1;

        border-radius: 9px;

        outline: none;

        background: white;

        color: #172554;

        font-size: 13px;
    }


    .search-input:focus
    {
        border-color: #2563eb;

        box-shadow:
            0 0 0 3px
            rgba(37,99,235,.10);
    }


    .search-btn
    {
        padding: 12px 18px;

        background: #2563eb;

        color: white;

        border: 1px solid #2563eb;

        border-radius: 9px;

        font-size: 13px;

        font-weight: 600;

        cursor: pointer;
    }


    .search-btn:hover
    {
        background: #1d4ed8;
    }


    .clear-btn
    {
        padding: 12px 16px;

        background: white;

        color: #475569;

        border: 1px solid #cbd5e1;

        border-radius: 9px;

        text-decoration: none;

        font-size: 13px;

        font-weight: 600;
    }


    .clear-btn:hover
    {
        background: #f8fafc;

        color: #172554;
    }


    .search-help
    {
        margin-top: 8px;

        color: #94a3b8;

        font-size: 11px;
    }


    /* ============================================================
       RESULTS INFO
    ============================================================ */

    .results-info
    {
        display: flex;

        justify-content: space-between;

        align-items: center;

        margin-bottom: 10px;

        color: #64748b;

        font-size: 12px;
    }


    .results-info strong
    {
        color: #172554;
    }


    /* ============================================================
       CUSTOMER LIST
    ============================================================ */

    .customer-list
    {
        display: flex;

        flex-direction: column;

        gap: 12px;

        width: 100%;
    }


    .customer-card
    {
        display: grid;

        grid-template-columns:
            1fr auto auto;

        align-items: center;

        gap: 25px;

        width: 100%;

        box-sizing: border-box;

        padding: 20px;

        background: white;

        border: 1px solid #e2e8f0;

        border-radius: 14px;

        box-shadow:
            0 4px 14px
            rgba(15,23,42,.04);
    }


    .customer-main
    {
        display: flex;

        align-items: center;

        gap: 14px;
    }


    .customer-icon
    {
        width: 45px;

        height: 45px;

        display: flex;

        align-items: center;

        justify-content: center;

        background: #eff6ff;

        border-radius: 50%;

        font-size: 20px;

        flex-shrink: 0;
    }


    .customer-main h2
    {
        margin: 0;

        color: #172554;

        font-size: 16px;

        font-weight: 700;
    }


    .customer-main p
    {
        margin: 4px 0 0;

        color: #64748b;

        font-size: 12px;
    }


    /* ============================================================
       BALANCE
    ============================================================ */

    .customer-balance
    {
        text-align: right;
    }


    .customer-balance span
    {
        display: block;

        color: #64748b;

        font-size: 11px;
    }


    .customer-balance strong
    {
        display: block;

        margin-top: 4px;

        color: #dc2626;

        font-size: 18px;
    }


    /* ============================================================
       BUTTON
    ============================================================ */

    .view-btn
    {
        display: inline-block;

        padding: 10px 14px;

        background: #2563eb;

        color: white;

        border-radius: 8px;

        text-decoration: none;

        font-size: 12px;

        font-weight: 600;

        white-space: nowrap;
    }


    .view-btn:hover
    {
        background: #1d4ed8;

        color: white;
    }


    /* ============================================================
       EMPTY STATE
    ============================================================ */

    .empty-card
    {
        width: 100%;

        box-sizing: border-box;

        padding: 60px 20px;

        text-align: center;

        background: white;

        border: 1px solid #e2e8f0;

        border-radius: 15px;

        box-shadow:
            0 4px 14px
            rgba(15,23,42,.04);
    }


    .empty-icon
    {
        width: 55px;

        height: 55px;

        margin: 0 auto 15px;

        display: flex;

        align-items: center;

        justify-content: center;

        background: #f0fdf4;

        color: #16a34a;

        border-radius: 50%;

        font-size: 25px;
    }


    .empty-card h2
    {
        margin: 0;

        color: #172554;

        font-size: 20px;
    }


    .empty-card p
    {
        color: #64748b;

        font-size: 13px;
    }


    .clear-results-btn
    {
        display: inline-block;

        margin-top: 10px;

        padding: 10px 15px;

        background: #2563eb;

        color: white;

        border-radius: 8px;

        text-decoration: none;

        font-size: 12px;

        font-weight: 600;
    }


    .clear-results-btn:hover
    {
        background: #1d4ed8;
    }


    /* ============================================================
       MESSAGES
    ============================================================ */

    .success-message
    {
        padding: 12px 15px;

        margin-bottom: 15px;

        border-radius: 9px;

        background: #f0fdf4;

        border: 1px solid #bbf7d0;

        color: #15803d;

        font-size: 13px;

        font-weight: 600;
    }


    .error-message
    {
        padding: 12px 15px;

        margin-bottom: 15px;

        border-radius: 9px;

        background: #fef2f2;

        border: 1px solid #fecaca;

        color: #dc2626;

        font-size: 13px;
    }


    /* ============================================================
       MOBILE
    ============================================================ */

    @@media (max-width: 700px)
    {
        .credit-header
        {
            flex-direction: column;

            align-items: flex-start;

            gap: 12px;
        }


        .back-btn
        {
            width: 100%;

            box-sizing: border-box;

            text-align: center;
        }


        .search-form
        {
            flex-direction: column;

            align-items: stretch;
        }


        .search-btn,
        .clear-btn
        {
            width: 100%;

            text-align: center;

            box-sizing: border-box;
        }


        .customer-card
        {
            grid-template-columns: 1fr;
        }


        .customer-balance
        {
            text-align: left;
        }


        .view-btn
        {
            width: 100%;

            text-align: center;

            box-sizing: border-box;
        }


        .results-info
        {
            flex-direction: column;

            align-items: flex-start;

            gap: 5px;
        }
    }

</style>