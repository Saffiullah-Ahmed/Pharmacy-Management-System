@model PharmacyManagementSystem.Web.Models.Supplier

@{
    ViewData["Title"] = "Delete Supplier";
}

<div class="medicine-form-page">

    <!-- PAGE HEADER -->
    <div class="medicine-form-header">

        <div>
            <h1>Delete Supplier</h1>

            <p>
                Confirm supplier deletion
            </p>
        </div>

        <a asp-controller="Supplier"
           asp-action="Index"
           class="back-medicine-btn">
            ← Back to Suppliers
        </a>

    </div>


    <!-- DELETE CARD -->
    <div class="medicine-form-card delete-confirm-card">

        <!-- HEADER -->
        <div class="form-card-header">

            <div class="form-icon delete-form-icon">
                🗑️
            </div>

            <div>
                <h2>Delete Supplier</h2>

                <p>
                    Review the supplier information before deleting
                </p>
            </div>

        </div>


        <!-- WARNING -->
        <div class="delete-warning">

            <strong>
                ⚠️ Are you sure you want to delete this supplier?
            </strong>

            <p>
                This action cannot be undone. The supplier will be permanently
                removed from your supplier list.
            </p>

        </div>


        <!-- SUPPLIER DETAILS -->
        <div class="delete-medicine-details">

            <div class="delete-detail">

                <span>
                    Supplier ID
                </span>

                <strong>
                    #@Model.Id
                </strong>

            </div>


            <div class="delete-detail">

                <span>
                    Supplier Name
                </span>

                <strong>
                    @Model.Name
                </strong>

            </div>


            <div class="delete-detail">

                <span>
                    Company
                </span>

                <strong>
                    @Model.Company
                </strong>

            </div>


            <div class="delete-detail">

                <span>
                    Phone
                </span>

                <strong>
                    @Model.Phone
                </strong>

            </div>


            <div class="delete-detail">

                <span>
                    Email
                </span>

                <strong>
                    @Model.Email
                </strong>

            </div>


            <div class="delete-detail">

                <span>
                    Address
                </span>

                <strong>
                    @Model.Address
                </strong>

            </div>

        </div>


        <!-- ACTIONS -->
        <div class="form-actions">

            <a asp-controller="Supplier"
               asp-action="Index"
               class="cancel-btn">
                Cancel
            </a>


            <form asp-controller="Supplier"
                  asp-action="DeleteConfirmed"
                  method="post">

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="delete-confirm-btn">
                    🗑️ Delete Supplier
                </button>

            </form>

        </div>

    </div>

</div>