@model PharmacyManagementSystem.Web.Models.User

@{
    ViewData["Title"] = "User Permissions";

    var availablePermissions =
        ViewBag.AvailablePermissions as List<string>
        ?? new List<string>();

    var selectedPermissions =
        Model.Permissions
        ?? new List<string>();
}

<div class="permissions-page">

    <!-- HEADER -->

    <div class="page-header">

        <div>

            <h1>User Permissions</h1>

            <p>
                Control which modules this staff member can access
            </p>

        </div>

        <a asp-action="Index"
           class="back-btn">

            ← Back to Users

        </a>

    </div>


    <!-- USER CARD -->

    <div class="user-card">

        <div class="avatar">

            @if (!string.IsNullOrWhiteSpace(Model.Username))
            {
                @Model.Username.Substring(0, 1).ToUpper()
            }

        </div>

        <div class="user-details">

            <h2>
                @Model.Username
            </h2>

            <p>
                Staff Account
                <span>•</span>
                Pharmacy ID: @Model.PharmacyId
            </p>

        </div>

        <div class="status-badge @(Model.IsActive ? "active" : "inactive")">

            @if (Model.IsActive)
            {
                <span>● Active</span>
            }
            else
            {
                <span>● Inactive</span>
            }

        </div>

    </div>


    <!-- PERMISSIONS CARD -->

    <div class="permissions-card">

        <div class="card-header">

            <div>

                <h2>Access Permissions</h2>

                <p>
                    Select the modules this user is allowed to access.
                </p>

            </div>

            <div class="permission-count">

                <span id="permissionCount">
                    @selectedPermissions.Count
                </span>

                Selected

            </div>

        </div>


        <form asp-action="Permissions"
              method="post"
              id="permissionsForm">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />


            <div class="permission-list">

                @foreach (var permission in availablePermissions)
                {
                    var isSelected =
                        selectedPermissions.Any(
                            p => string.Equals(
                                p,
                                permission,
                                StringComparison.OrdinalIgnoreCase));


                    string description =
                        permission switch
                        {
                            "Medicine Management" =>
                                "Add, edit, delete, and search medicines.",

                            "Stock Management" =>
                                "Manage stock, low-stock alerts, and expiry checks.",

                            "Sales Management" =>
                                "Create sales, process returns, and view sales history.",

                            "Reports" =>
                                "View pharmacy reports and business summaries.",

                            _ =>
                                "Access this application module."
                        };


                    <label class="permission-item">

                        <input type="checkbox"
                               name="permissions"
                               value="@permission"
                               class="permission-checkbox"
                               @(isSelected ? "checked" : "") />

                        <span class="custom-checkbox"></span>

                        <span class="permission-content">

                            <strong>
                                @permission
                            </strong>

                            <small>
                                @description
                            </small>

                        </span>

                    </label>
                }

            </div>


            <!-- QUICK ACTIONS -->

            <div class="quick-actions">

                <button type="button"
                        class="quick-btn"
                        onclick="selectAllPermissions()">

                    Select All

                </button>

                <button type="button"
                        class="quick-btn"
                        onclick="clearPermissions()">

                    Clear All

                </button>

            </div>


            <!-- ACTIONS -->

            <div class="form-actions">

                <a asp-action="Index"
                   class="cancel-btn">

                    Cancel

                </a>

                <button type="submit"
                        class="save-btn">

                    ✓ Save Permissions

                </button>

            </div>

        </form>

    </div>


    <!-- INFORMATION -->

    <div class="info-box">

        <div class="info-icon">
            ℹ
        </div>

        <div>

            <strong>Administrator Access</strong>

            <p>
                Administrator accounts automatically have full access
                to the pharmacy system. Staff accounts can only access
                modules explicitly assigned to them.
            </p>

        </div>

    </div>

</div>


<script>

    const checkboxes =
        document.querySelectorAll(
            ".permission-checkbox");


    function updatePermissionCount()
    {
        const selected =
            document.querySelectorAll(
                ".permission-checkbox:checked").length;

        document.getElementById(
            "permissionCount").textContent =
            selected;
    }


    function selectAllPermissions()
    {
        checkboxes.forEach(
            checkbox =>
            {
                checkbox.checked = true;
            });

        updatePermissionCount();
    }


    function clearPermissions()
    {
        checkboxes.forEach(
            checkbox =>
            {
                checkbox.checked = false;
            });

        updatePermissionCount();
    }


    checkboxes.forEach(
        checkbox =>
        {
            checkbox.addEventListener(
                "change",
                updatePermissionCount);
        });


    updatePermissionCount();

</script>


<style>

    .permissions-page
    {
        max-width: 900px;

        margin: 0 auto;
    }


    /* ============================================================
       HEADER
    ============================================================ */

    .page-header
    {
        display: flex;

        justify-content: space-between;

        align-items: center;

        margin-bottom: 22px;
    }


    .page-header h1
    {
        margin: 0;

        color: #172554;

        font-size: 30px;

        font-weight: 800;
    }


    .page-header p
    {
        margin: 5px 0 0;

        color: #64748b;

        font-size: 14px;
    }


    .back-btn
    {
        padding: 10px 15px;

        background: white;

        color: #475569;

        border: 1px solid #e2e8f0;

        border-radius: 9px;

        text-decoration: none;

        font-size: 13px;

        font-weight: 600;
    }


    .back-btn:hover
    {
        background: #f8fafc;

        color: #172554;
    }


    /* ============================================================
       USER CARD
    ============================================================ */

    .user-card
    {
        display: flex;

        align-items: center;

        gap: 14px;

        padding: 20px;

        margin-bottom: 18px;

        background: white;

        border: 1px solid #dbeafe;

        border-radius: 15px;

        box-shadow:
            0 4px 16px
            rgba(15,23,42,.04);
    }


    .avatar
    {
        width: 48px;
        height: 48px;

        flex-shrink: 0;

        display: flex;

        align-items: center;
        justify-content: center;

        background: #dbeafe;

        color: #1d4ed8;

        border-radius: 12px;

        font-size: 18px;

        font-weight: 800;
    }


    .user-details
    {
        flex: 1;
    }


    .user-details h2
    {
        margin: 0;

        color: #172554;

        font-size: 18px;
    }


    .user-details p
    {
        margin: 5px 0 0;

        color: #64748b;

        font-size: 11px;
    }


    .user-details p span
    {
        margin: 0 5px;

        color: #cbd5e1;
    }


    .status-badge
    {
        padding: 7px 10px;

        border-radius: 7px;

        font-size: 10px;

        font-weight: 700;
    }


    .status-badge.active
    {
        background: #f0fdf4;

        color: #15803d;
    }


    .status-badge.inactive
    {
        background: #fef2f2;

        color: #dc2626;
    }


    /* ============================================================
       CARD
    ============================================================ */

    .permissions-card
    {
        background: white;

        border: 1px solid #e2e8f0;

        border-radius: 15px;

        padding: 25px;

        box-shadow:
            0 4px 16px
            rgba(15,23,42,.05);
    }


    .card-header
    {
        display: flex;

        justify-content: space-between;

        align-items: center;

        gap: 15px;

        padding-bottom: 20px;

        border-bottom: 1px solid #e2e8f0;

        margin-bottom: 18px;
    }


    .card-header h2
    {
        margin: 0;

        color: #172554;

        font-size: 18px;
    }


    .card-header p
    {
        margin: 5px 0 0;

        color: #64748b;

        font-size: 12px;
    }


    .permission-count
    {
        padding: 7px 10px;

        background: #eff6ff;

        color: #2563eb;

        border-radius: 7px;

        font-size: 10px;

        font-weight: 700;

        white-space: nowrap;
    }


    .permission-count span
    {
        font-size: 12px;
    }


    /* ============================================================
       PERMISSION LIST
    ============================================================ */

    .permission-list
    {
        display: grid;

        grid-template-columns:
            repeat(2, 1fr);

        gap: 12px;
    }


    .permission-item
    {
        position: relative;

        display: flex;

        align-items: flex-start;

        gap: 12px;

        padding: 16px;

        background: #f8fafc;

        border: 1px solid #e2e8f0;

        border-radius: 10px;

        cursor: pointer;

        transition: .2s;
    }


    .permission-item:hover
    {
        border-color: #bfdbfe;

        background: #f8fbff;
    }


    .permission-item input
    {
        position: absolute;

        opacity: 0;

        pointer-events: none;
    }


    .custom-checkbox
    {
        width: 18px;
        height: 18px;

        flex-shrink: 0;

        margin-top: 1px;

        background: white;

        border: 1px solid #cbd5e1;

        border-radius: 5px;

        position: relative;
    }


    .permission-checkbox:checked
        + .custom-checkbox
    {
        background: #2563eb;

        border-color: #2563eb;
    }


    .permission-checkbox:checked
        + .custom-checkbox::after
    {
        content: "✓";

        position: absolute;

        left: 3px;

        top: -1px;

        color: white;

        font-size: 13px;

        font-weight: 800;
    }


    .permission-content
    {
        flex: 1;
    }


    .permission-content strong
    {
        display: block;

        color: #172554;

        font-size: 13px;
    }


    .permission-content small
    {
        display: block;

        margin-top: 5px;

        color: #64748b;

        font-size: 10px;

        line-height: 1.5;
    }


    /* ============================================================
       QUICK ACTIONS
    ============================================================ */

    .quick-actions
    {
        display: flex;

        gap: 8px;

        margin-top: 17px;
    }


    .quick-btn
    {
        padding: 7px 11px;

        background: white;

        color: #475569;

        border: 1px solid #cbd5e1;

        border-radius: 7px;

        font-size: 10px;

        font-weight: 700;

        cursor: pointer;
    }


    .quick-btn:hover
    {
        background: #f8fafc;

        color: #172554;
    }


    /* ============================================================
       ACTIONS
    ============================================================ */

    .form-actions
    {
        display: flex;

        justify-content: flex-end;

        gap: 10px;

        margin-top: 25px;

        padding-top: 20px;

        border-top: 1px solid #e2e8f0;
    }


    .cancel-btn,
    .save-btn
    {
        padding: 11px 17px;

        border-radius: 9px;

        font-size: 12px;

        font-weight: 700;

        cursor: pointer;

        text-decoration: none;
    }


    .cancel-btn
    {
        background: white;

        color: #475569;

        border: 1px solid #cbd5e1;
    }


    .cancel-btn:hover
    {
        background: #f8fafc;
    }


    .save-btn
    {
        background: #2563eb;

        color: white;

        border: 1px solid #2563eb;
    }


    .save-btn:hover
    {
        background: #1d4ed8;
    }


    /* ============================================================
       INFO
    ============================================================ */

    .info-box
    {
        display: flex;

        gap: 12px;

        margin-top: 18px;

        padding: 15px;

        background: #eff6ff;

        border: 1px solid #bfdbfe;

        border-radius: 10px;
    }


    .info-icon
    {
        width: 25px;
        height: 25px;

        flex-shrink: 0;

        display: flex;

        align-items: center;
        justify-content: center;

        background: #dbeafe;

        color: #2563eb;

        border-radius: 50%;

        font-size: 12px;

        font-weight: 800;
    }


    .info-box strong
    {
        display: block;

        color: #1e3a8a;

        font-size: 12px;
    }


    .info-box p
    {
        margin: 4px 0 0;

        color: #475569;

        font-size: 11px;

        line-height: 1.5;
    }


    /* ============================================================
       MOBILE
    ============================================================ */

    @@media (max-width: 650px)
    {
        .page-header
        {
            flex-direction: column;

            align-items: flex-start;

            gap: 12px;
        }


        .user-card
        {
            flex-wrap: wrap;
        }


        .status-badge
        {
            margin-left: 62px;
        }


        .permission-list
        {
            grid-template-columns: 1fr;
        }


        .card-header
        {
            align-items: flex-start;

            flex-direction: column;
        }


        .form-actions
        {
            flex-direction: column;
        }


        .cancel-btn,
        .save-btn
        {
            width: 100%;

            box-sizing: border-box;

            text-align: center;
        }
    }

</style>