@model PharmacyManagementSystem.Web.Models.User

@{
    ViewData["Title"] = "Add User";
}

<div class="user-page">

    <!-- HEADER -->

    <div class="page-header">

        <div>
            <h1>Add User</h1>

            <p>
                Create a staff account for your pharmacy
            </p>
        </div>

        <a asp-action="Index"
           class="back-btn">

            ← Back to Users

        </a>

    </div>


    <!-- ERROR -->

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="message error-message">
            ⚠ @TempData["ErrorMessage"]
        </div>
    }


    <!-- FORM CARD -->

    <div class="form-card">

        <div class="card-header">

            <div class="card-icon">
                👤
            </div>

            <div>
                <h2>Create Staff Account</h2>

                <p>
                    Add a new staff member to this pharmacy.
                </p>
            </div>

        </div>


        <form asp-action="Add"
              method="post">

            @Html.AntiForgeryToken()


            <!-- USERNAME -->

            <div class="form-group">

                <label for="Username">
                    Username
                </label>

                <input asp-for="Username"
                       id="Username"
                       class="form-control"
                       placeholder="Enter username"
                       autocomplete="off"
                       required />

                <small>
                    Username must be unique across the system.
                </small>

            </div>


            <!-- ROLE -->

            <div class="form-group">

                <label>
                    Role
                </label>

                <div class="role-box">

                    <div class="role-icon">
                        👨‍💼
                    </div>

                    <div>

                        <strong>Staff</strong>

                        <span>
                            Permissions will be assigned by the administrator.
                        </span>

                    </div>

                </div>

            </div>


            <!-- PASSWORD -->

            <div class="form-group">

                <label for="password">
                    Password
                </label>

                <input type="password"
                       name="password"
                       id="password"
                       class="form-control"
                       placeholder="Enter password"
                       autocomplete="new-password"
                       required />

                <small>
                    Minimum 8 characters with uppercase, lowercase,
                    number, and special character.
                </small>

            </div>


            <!-- CONFIRM PASSWORD -->

            <div class="form-group">

                <label for="confirmPassword">
                    Confirm Password
                </label>

                <input type="password"
                       name="confirmPassword"
                       id="confirmPassword"
                       class="form-control"
                       placeholder="Confirm password"
                       autocomplete="new-password"
                       required />

            </div>


            <!-- ACTIONS -->

            <div class="form-actions">

                <a asp-action="Index"
                   class="cancel-btn">

                    Cancel

                </a>

                <button type="submit"
                        class="primary-btn">

                    ✓ Create User

                </button>

            </div>

        </form>

    </div>

</div>


<style>

    .user-page
    {
        max-width: 850px;
        margin: 0 auto;
    }


    .page-header
    {
        display: flex;
        justify-content: space-between;
        align-items: center;

        margin-bottom: 22px;
    }


    .page-header h1
    {
        margin: 0;

        color: #172554;

        font-size: 30px;

        font-weight: 800;
    }


    .page-header p
    {
        margin: 5px 0 0;

        color: #64748b;

        font-size: 14px;
    }


    .back-btn
    {
        padding: 10px 15px;

        background: white;

        color: #475569;

        border: 1px solid #e2e8f0;

        border-radius: 9px;

        text-decoration: none;

        font-size: 13px;

        font-weight: 600;
    }


    .back-btn:hover
    {
        background: #f8fafc;

        color: #172554;
    }


    .message
    {
        padding: 12px 15px;

        margin-bottom: 18px;

        border-radius: 9px;

        font-size: 13px;

        font-weight: 600;
    }


    .error-message
    {
        background: #fef2f2;

        border: 1px solid #fecaca;

        color: #dc2626;
    }


    .form-card
    {
        background: white;

        border: 1px solid #e2e8f0;

        border-radius: 15px;

        padding: 28px;

        box-shadow:
            0 4px 16px
            rgba(15,23,42,.05);
    }


    .card-header
    {
        display: flex;

        align-items: center;

        gap: 14px;

        margin-bottom: 28px;

        padding-bottom: 20px;

        border-bottom: 1px solid #e2e8f0;
    }


    .card-icon
    {
        width: 48px;
        height: 48px;

        display: flex;

        align-items: center;
        justify-content: center;

        background: #eff6ff;

        border-radius: 12px;

        font-size: 23px;
    }


    .card-header h2
    {
        margin: 0;

        color: #172554;

        font-size: 20px;
    }


    .card-header p
    {
        margin: 5px 0 0;

        color: #64748b;

        font-size: 13px;
    }


    .form-group
    {
        margin-bottom: 21px;
    }


    .form-group label
    {
        display: block;

        margin-bottom: 7px;

        color: #334155;

        font-size: 12px;

        font-weight: 700;
    }


    .form-control
    {
        width: 100%;

        box-sizing: border-box;

        padding: 12px 13px;

        border: 1px solid #cbd5e1;

        border-radius: 9px;

        outline: none;

        background: white;

        color: #172554;

        font-size: 13px;

        transition: .2s;
    }


    .form-control:focus
    {
        border-color: #2563eb;

        box-shadow:
            0 0 0 3px
            rgba(37,99,235,.10);
    }


    .form-group small
    {
        display: block;

        margin-top: 6px;

        color: #94a3b8;

        font-size: 11px;

        line-height: 1.5;
    }


    .role-box
    {
        display: flex;

        align-items: center;

        gap: 12px;

        padding: 14px;

        background: #f8fafc;

        border: 1px solid #e2e8f0;

        border-radius: 10px;
    }


    .role-icon
    {
        width: 38px;
        height: 38px;

        display: flex;

        align-items: center;
        justify-content: center;

        background: #dbeafe;

        border-radius: 9px;

        font-size: 18px;
    }


    .role-box strong
    {
        display: block;

        color: #172554;

        font-size: 13px;
    }


    .role-box span
    {
        display: block;

        margin-top: 3px;

        color: #64748b;

        font-size: 11px;
    }


    .form-actions
    {
        display: flex;

        justify-content: flex-end;

        gap: 10px;

        margin-top: 28px;

        padding-top: 20px;

        border-top: 1px solid #e2e8f0;
    }


    .cancel-btn
    {
        padding: 11px 17px;

        background: white;

        color: #475569;

        border: 1px solid #cbd5e1;

        border-radius: 9px;

        text-decoration: none;

        font-size: 13px;

        font-weight: 600;
    }


    .cancel-btn:hover
    {
        background: #f8fafc;
    }


    .primary-btn
    {
        padding: 11px 18px;

        background: #2563eb;

        color: white;

        border: none;

        border-radius: 9px;

        font-size: 13px;

        font-weight: 600;

        cursor: pointer;
    }


    .primary-btn:hover
    {
        background: #1d4ed8;
    }


    @@media (max-width: 600px)
    {
        .page-header
        {
            flex-direction: column;

            align-items: flex-start;

            gap: 12px;
        }


        .form-actions
        {
            flex-direction: column;
        }


        .cancel-btn,
        .primary-btn
        {
            width: 100%;

            box-sizing: border-box;

            text-align: center;
        }
    }

</style>